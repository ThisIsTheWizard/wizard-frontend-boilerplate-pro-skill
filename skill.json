    "claude-code": ">=1.0.0",
    "codex": ">=1.0.0",
    "continue": ">=1.0.0",
    "cursor": ">=1.0.0",
    "gemini": ">=1.0.0",
    "gemini-cli": ">=1.0.0",
    "opencode": ">=1.0.0",
    "tabby": ">=1.0.0",
    "windsurf": ">=1.0.0"
  }
