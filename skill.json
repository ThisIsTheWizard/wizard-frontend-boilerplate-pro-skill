{
  "name": "wizard-frontend-boilerplate-pro",
  "version": "1.0.0",
  "author": "The Wizard",
  "owner": "ThisIsTheWizard",
  "description": "Scaffold production-ready frontend apps with Next.js, React, Vue, Nuxt, or SvelteKit — 28 UI components, OKLCH color palettes, light/dark theming, WCAG AA contrast.",
  "entry": "SKILL.md",
  "homepage": "https://github.com/ThisIsTheWizard/wizard-frontend-boilerplate-pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThisIsTheWizard/wizard-frontend-boilerplate-pro.git"
  },
  "plugins": [
    {
      "type": "skill",
      "name": "ui-ux-pro-max",
      "source": "local",
      "optional": true,
      "description": "Sibling skill used as component source. Falls back to built-in implementations when not installed."
    }
  ],
  "portable": true,
  "tested_agents": [
    "aider",
    "claude",
    "claude-code",
    "codex",
    "continue",
    "cursor",
    "gemini",
    "gemini-cli",
    "opencode",
    "tabby",
    "windsurf"
  ],
  "compatibility": {
    "aider": ">=1.0.0",
    "claude": ">=1.0.0",
    "claude-code": ">=1.0.0",
    "codex": ">=1.0.0",
    "continue": ">=1.0.0",
    "cursor": ">=1.0.0",
    "gemini": ">=1.0.0",
    "gemini-cli": ">=1.0.0",
    "opencode": ">=1.0.0",
    "tabby": ">=1.0.0",
    "windsurf": ">=1.0.0"
  }
}
