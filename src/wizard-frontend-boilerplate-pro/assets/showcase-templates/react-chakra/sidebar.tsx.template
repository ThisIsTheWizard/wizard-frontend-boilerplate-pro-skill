"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";

import { Badge, Box, Flex, Text, VStack } from "@chakra-ui/react";

interface NavItem {
  category: string;
  components: string[];
  icon: React.FC;
  slug: string;
}

interface SidebarProps {
  onNavigate?: () => void;
}

function LogoIcon() {
  return (
    <svg
      aria-hidden="true"
      fill="none"
      height="20"
      viewBox="0 0 20 20"
      width="20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect fill="currentColor" height="7" opacity="0.9" rx="1.5" width="7" x="2" y="2" />
      <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="11" y="2" />
      <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="2" y="11" />
      <rect fill="currentColor" height="7" opacity="0.3" rx="1.5" width="7" x="11" y="11" />
    </svg>
  );
}

function BarChartIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="12" rx="1" width="4" x="3" y="9" />
      <rect height="18" rx="1" width="4" x="10" y="3" />
      <rect height="8" rx="1" width="4" x="17" y="13" />
    </svg>
  );
}

function SquaresIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="7" rx="1.5" width="7" x="3" y="3" />
      <rect height="7" rx="1.5" width="7" x="14" y="3" />
      <rect height="7" rx="1.5" width="7" x="3" y="14" />
      <rect height="7" rx="1.5" width="7" x="14" y="14" />
    </svg>
  );
}

function BellIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
      <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
    </svg>
  );
}

function CursorIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="m4 4 7.07 17 2.51-7.39L21 11.07z" />
    </svg>
  );
}

function CompassIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" />
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
    </svg>
  );
}

function LayersIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </svg>
  );
}

const NAV_ITEMS: NavItem[] = [
  {
    category: "Data viz",
    components: ["Chart", "DataTable", "Calendar"],
    icon: BarChartIcon,
    slug: "data-viz",
  },
  {
    category: "Display",
    components: ["Card", "Badge", "Avatar", "Separator", "Skeleton", "Table"],
    icon: SquaresIcon,
    slug: "display",
  },
  {
    category: "Feedback",
    components: ["Alert", "Toast", "Progress", "Tooltip", "Dialog"],
    icon: BellIcon,
    slug: "feedback",
  },
  {
    category: "Inputs",
    components: ["Button", "Input", "Textarea", "Select", "Checkbox", "RadioGroup", "Switch"],
    icon: CursorIcon,
    slug: "inputs",
  },
  {
    category: "Navigation",
    components: ["Tabs", "Breadcrumb", "Pagination"],
    icon: CompassIcon,
    slug: "navigation",
  },
  {
    category: "Overlay",
    components: ["Popover", "Menu", "Drawer"],
    icon: LayersIcon,
    slug: "overlay",
  },
];

function toSlug(name: string): string {
  return name
    .replace(/[A-Z]/g, (char, offset: number) => (offset > 0 ? `-${char}` : char))
    .toLowerCase();
}

export function Sidebar({ onNavigate }: SidebarProps) {
  const pathname = usePathname();
  const [activeAnchor, setActiveAnchor] = useState("");

  const activeSlug = pathname.startsWith("/library/")
    ? pathname.slice("/library/".length)
    : "";

  useEffect(() => {
    setActiveAnchor("");

    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    if (sections.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveAnchor(entry.target.id);
          }
        }
      },
      { rootMargin: "-80px 0px -66% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
    return () => observer.disconnect();
  }, [pathname]);

  const totalComponents = NAV_ITEMS.reduce(
    (acc, { components }) => acc + components.length,
    0,
  );

  return (
    <Flex direction="column" h="100%">
      {/* Logo header */}
      <Flex
        align="center"
        borderBottom="1px solid"
        borderColor="var(--border)"
        flexShrink={0}
        gap={3}
        h="56px"
        px={4}
      >
        <Box color="var(--color-accent-500)">
          <LogoIcon />
        </Box>
        <Text
          as={Link}
          href="/library"
          color="var(--foreground)"
          fontSize="sm"
          fontWeight={600}
          onClick={onNavigate}
          textDecoration="none"
          _hover={{ color: "var(--color-accent-500)" }}
        >
          Component Library
        </Text>
      </Flex>

      {/* Navigation */}
      <Box flex={1} overflowY="auto" py={2}>
        <VStack align="stretch" gap={0.5} px={2}>
          {NAV_ITEMS.map(({ category, components, icon: Icon, slug }) => {
            const isCategoryActive = activeSlug === slug;

            return (
              <Box key={slug}>
                {/* Category link */}
                <Flex
                  as={Link}
                  href={`/library/${slug}`}
                  onClick={onNavigate}
                  align="center"
                  borderRadius="md"
                  gap={3}
                  px={3}
                  py={2}
                  fontSize="sm"
                  fontWeight={500}
                  textDecoration="none"
                  bg={
                    isCategoryActive
                      ? "var(--color-accent-500)"
                      : "transparent"
                  }
                  color={
                    isCategoryActive ? "#fff" : "var(--foreground)"
                  }
                  _hover={
                    isCategoryActive
                      ? { bg: "var(--color-accent-600)" }
                      : { bg: "var(--surface)" }
                  }
                >
                  <Box flexShrink={0}>
                    <Icon />
                  </Box>
                  <Text flex={1} fontSize="sm" fontWeight={500}>
                    {category}
                  </Text>
                  <Badge
                    borderRadius="full"
                    fontSize="10px"
                    h="18px"
                    minW="18px"
                    px={1.5}
                    variant="subtle"
                  >
                    {components.length}
                  </Badge>
                </Flex>

                {/* Component anchors */}
                <Box
                  borderLeft="1px solid"
                  borderColor="var(--border)"
                  ml={6}
                  mt={1}
                  pl={3}
                >
                  {components.map((component) => {
                    const componentSlug = toSlug(component);
                    const isAnchorActive =
                      isCategoryActive && activeAnchor === componentSlug;

                    return (
                      <Box key={componentSlug}>
                        <Text
                          as={Link}
                          href={`/library/${slug}#${componentSlug}`}
                          onClick={onNavigate}
                          borderRadius="md"
                          color={
                            isAnchorActive
                              ? "var(--color-accent-500)"
                              : "var(--muted-foreground)"
                          }
                          display="block"
                          fontSize="13px"
                          fontWeight={isAnchorActive ? 600 : 400}
                          px={2}
                          py={1}
                          textDecoration="none"
                          _hover={{
                            bg: "var(--surface)",
                            color: "var(--foreground)",
                          }}
                        >
                          {component}
                        </Text>
                      </Box>
                    );
                  })}
                </Box>
              </Box>
            );
          })}
        </VStack>
      </Box>

      {/* Footer */}
      <Box
        borderTop="1px solid"
        borderColor="var(--border)"
        flexShrink={0}
        px={4}
        py={3}
      >
        <Text color="var(--muted-foreground)" fontSize="xs">
          {totalComponents} components
        </Text>
      </Box>
    </Flex>
  );
}
