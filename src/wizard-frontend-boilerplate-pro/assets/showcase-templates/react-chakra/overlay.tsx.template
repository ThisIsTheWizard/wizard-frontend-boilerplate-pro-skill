        >
          <Menu.Root>
            <Menu.Trigger asChild>
              <Button variant="outline">Account</Button>
            </Menu.Trigger>
            <Portal>
              <Menu.Positioner>
                <Menu.Content>
                  <Menu.Item disabled value="label">
                    <Text color="var(--muted-foreground)" fontSize="xs">
                      My Account
                    </Text>
                  </Menu.Item>
                  <Menu.Item value="profile">Profile</Menu.Item>
                  <Menu.Item value="settings">Settings</Menu.Item>
                  <Menu.Item value="billing">Billing</Menu.Item>
                  <Menu.Separator />
                  <Menu.Item value="logout">Log out</Menu.Item>
                </Menu.Content>
              </Menu.Positioner>
            </Portal>
          </Menu.Root>
        </Box>
        <CodeBlock
          code={MENU_CODE}
          collapsible
          defaultOpen={false}
          filename="Menu.tsx"
          language="tsx"
        />
      </Box>

      <Separator />

      {/* Drawer */}
      <Box as="section" display="flex" flexDirection="column" gap={4} id="drawer">
        <Box borderLeft="3px solid" borderColor="var(--color-accent-500)" pl={3}>
          <Heading mb={1} size="md">Drawer</Heading>
          <Text color="var(--muted-foreground)" fontSize="sm">
            A side panel that slides in from an edge — Chakra's equivalent of
