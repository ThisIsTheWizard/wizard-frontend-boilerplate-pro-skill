"use client";

import { useState } from "react";

import {
  Box,
  Button,
  Drawer,
  Flex,
  Heading,
  Menu,
  Popover,
  Portal,
  Separator,
  Stack,
  Text,
} from "@chakra-ui/react";

import { CodeBlock } from "@/components/ui/code-block";

const POPOVER_CODE = `import { Box, Button, Popover, Portal, Text } from "@chakra-ui/react";

export function Example() {
  return (
    <Popover.Root>
      <Popover.Trigger asChild>
        <Button variant="outline">Open Popover</Button>
      </Popover.Trigger>
      <Portal>
        <Popover.Positioner>
          <Popover.Content>
            <Popover.Arrow />
            <Popover.Body>
              <Box>
                <Text fontWeight={600} mb={1}>Popover title</Text>
                <Text color="var(--muted-foreground)" fontSize="sm">
                  This is a popover with some helpful content.
                </Text>
              </Box>
            </Popover.Body>
            <Popover.CloseTrigger asChild>
              <Button size="xs" variant="ghost" position="absolute" right={1} top={1}>
                ✕
              </Button>
            </Popover.CloseTrigger>
          </Popover.Content>
        </Popover.Positioner>
      </Portal>
    </Popover.Root>
  );
}`;

const MENU_CODE = `import { Button, Menu, Portal, Separator, Text } from "@chakra-ui/react";

export function Example() {
  return (
    <Menu.Root>
      <Menu.Trigger asChild>
        <Button variant="outline">Account</Button>
      </Menu.Trigger>
      <Portal>
        <Menu.Positioner>
          <Menu.Content>
            <Menu.Item value="label" disabled>
              <Text color="var(--muted-foreground)" fontSize="xs">My Account</Text>
            </Menu.Item>
            <Menu.Item value="profile">Profile</Menu.Item>
            <Menu.Item value="settings">Settings</Menu.Item>
            <Menu.Item value="billing">Billing</Menu.Item>
            <Menu.Separator />
            <Menu.Item value="logout">Log out</Menu.Item>
          </Menu.Content>
        </Menu.Positioner>
      </Portal>
    </Menu.Root>
  );
}`;

const DRAWER_CODE = `import { useState } from "react";
import {
  Box,
  Button,
  Drawer,
  Portal,
  Separator,
  Text,
} from "@chakra-ui/react";

export function Example() {
  const [open, setOpen] = useState(false);

  return (
    <>
      <Button onClick={() => setOpen(true)} variant="outline">
        Open drawer
      </Button>
      <Drawer.Root
        onOpenChange={(e) => setOpen(e.open)}
        open={open}
        placement="end"
      >
        <Portal>
          <Drawer.Backdrop />
          <Drawer.Positioner>
            <Drawer.Content>
              <Drawer.Header>
                <Drawer.Title>Panel title</Drawer.Title>
              </Drawer.Header>
              <Drawer.Body>
                <Text color="var(--muted-foreground)" fontSize="sm">
                  This is a right-anchored drawer — Chakra's equivalent of
                  shadcn's Sheet component. Use it for filters, detail views,
                  or settings panels.
                </Text>
              </Drawer.Body>
              <Drawer.Footer>
                <Drawer.CloseTrigger asChild>
                  <Button variant="outline">Close</Button>
                </Drawer.CloseTrigger>
              </Drawer.Footer>
            </Drawer.Content>
          </Drawer.Positioner>
        </Portal>
      </Drawer.Root>
    </>
  );
}`;

export default function OverlayPage() {
  const [drawerOpen, setDrawerOpen] = useState(false);

  return (
    <Box display="flex" flexDirection="column" gap={16}>
      <Box>
        <Heading mb={2} size="2xl">
          Overlay
