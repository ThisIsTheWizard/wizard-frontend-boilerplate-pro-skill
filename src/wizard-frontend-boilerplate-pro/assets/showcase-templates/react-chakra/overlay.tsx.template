          <Heading mb={1} size="md">Popover</Heading>
          <Text color="var(--muted-foreground)" fontSize="sm">
            An anchored floating panel. Compose{" "}
            <code>Popover.Root</code> + <code>Popover.Trigger</code> +{" "}
            <code>Popover.Positioner</code> + <code>Popover.Content</code>.
            Wrap in a <code>Portal</code> to render at document root and avoid
            z-index clipping.
          </Text>
        </Box>
        <Box
          border="1px solid"
          borderColor="var(--border)"
          borderRadius="lg"
          p={6}
        >
          <Popover.Root>
            <Popover.Trigger asChild>
              <Button variant="outline">Open Popover</Button>
            </Popover.Trigger>
            <Portal>
              <Popover.Positioner>
                <Popover.Content>
                  <Popover.Arrow />
                  <Popover.Body>
                    <Box>
                      <Text fontWeight={600} mb={1}>Popover title</Text>
                      <Text color="var(--muted-foreground)" fontSize="sm">
                        This is a popover with some helpful content.
                      </Text>
                    </Box>
                  </Popover.Body>
                  <Popover.CloseTrigger asChild>
                    <Button
                      position="absolute"
                      right={1}
                      size="xs"
                      top={1}
                      variant="ghost"
                    >
                      ✕
                    </Button>
                  </Popover.CloseTrigger>
                </Popover.Content>
              </Popover.Positioner>
            </Portal>
          </Popover.Root>
        </Box>
        <CodeBlock
          code={POPOVER_CODE}
          collapsible
          defaultOpen={false}
          filename="Popover.tsx"
          language="tsx"
        />
      </Box>

