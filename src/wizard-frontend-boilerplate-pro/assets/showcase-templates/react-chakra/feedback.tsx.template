const TOAST_CODE = `import { createToaster, Button, Flex, Portal, Toaster } from "@chakra-ui/react";

// Create a toaster instance (singleton — define outside component)
const toaster = createToaster({ placement: "bottom-end" });

export function Example() {
  return (
    <>
      <Flex gap={2} wrap="wrap">
        <Button
          colorPalette="brand"
          onClick={() =>
            toaster.create({
              description: "Event has been created.",
              title: "Success",
              type: "success",
            })
          }
          variant="solid"
        >
          Success toast
        </Button>
        <Button
          onClick={() =>
            toaster.create({
              description: "Something went wrong.",
              title: "Error",
              type: "error",
            })
          }
          variant="outline"
        >
          Error toast
        </Button>
      </Flex>
      {/* Mount Toaster once in your layout or page root */}
      <Portal>
        <Toaster toaster={toaster} />
      </Portal>
    </>
  );
}`;

