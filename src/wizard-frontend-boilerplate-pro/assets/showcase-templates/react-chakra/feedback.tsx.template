const DIALOG_CODE = `import { useState } from "react";
import { Button, Dialog, Portal, Text } from "@chakra-ui/react";

export function Example() {
  const [open, setOpen] = useState(false);

  return (
    <>
      <Button colorPalette="brand" onClick={() => setOpen(true)} variant="solid">
        Open dialog
      </Button>
      <Dialog.Root onOpenChange={(e) => setOpen(e.open)} open={open}>
        <Portal>
          <Dialog.Backdrop />
          <Dialog.Positioner>
            <Dialog.Content maxW="sm">
              <Dialog.Header>
                <Dialog.Title>Confirm action</Dialog.Title>
              </Dialog.Header>
              <Dialog.Body>
                <Text>
                  This action cannot be undone. Are you sure you want to proceed?
                </Text>
              </Dialog.Body>
              <Dialog.Footer>
                <Dialog.ActionTrigger asChild>
                  <Button variant="outline">Cancel</Button>
                </Dialog.ActionTrigger>
                <Button colorPalette="brand" onClick={() => setOpen(false)}>
                  Confirm
                </Button>
              </Dialog.Footer>
              <Dialog.CloseTrigger asChild>
                <Button size="sm" variant="ghost" position="absolute" right={2} top={2}>
                  ✕
                </Button>
              </Dialog.CloseTrigger>
            </Dialog.Content>
          </Dialog.Positioner>
        </Portal>
      </Dialog.Root>
    </>
  );
}`;

