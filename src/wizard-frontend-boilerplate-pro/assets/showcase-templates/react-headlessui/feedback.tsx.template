              <button onClick={() => setOpen(false)} className="rounded-md bg-destructive px-4 py-2 text-sm font-medium text-white hover:opacity-90">
                Delete
              </button>
            </div>
          </DialogPanel>
        </div>
      </Dialog>
    </>
  );
}`;

let toastId = 0;

export default function FeedbackPage() {
