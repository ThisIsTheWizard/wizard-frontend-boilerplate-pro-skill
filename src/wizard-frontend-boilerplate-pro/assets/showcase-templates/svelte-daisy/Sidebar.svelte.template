<script lang="ts">
  import { onDestroy } from "svelte";
  import { page } from "$app/stores";

  interface NavItem {
    category: string;
    components: string[];
    slug: string;
  }

  interface Props {
    onNavigate?: () => void;
  }

  let { onNavigate }: Props = $props();

  const NAV_ITEMS: NavItem[] = [
    {
      category: "Data viz",
      components: ["Chart", "DataTable", "Calendar"],
      slug: "data-viz",
    },
    {
      category: "Display",
      components: ["Card", "Badge", "Avatar", "Separator", "Skeleton", "Table"],
      slug: "display",
    },
    {
      category: "Feedback",
      components: ["Alert", "Toast", "Progress", "Tooltip", "Modal"],
      slug: "feedback",
    },
    {
      category: "Inputs",
      components: ["Button", "Input", "Textarea", "Select", "Checkbox", "RadioGroup", "Toggle"],
      slug: "inputs",
    },
    {
      category: "Navigation",
      components: ["Tabs", "Breadcrumbs", "Pagination", "Navbar"],
      slug: "navigation",
    },
    {
      category: "Overlay",
      components: ["Tooltip", "Dropdown", "Drawer"],
      slug: "overlay",
    },
  ];

  let activeAnchor = $state("");

  function toSlug(name: string): string {
    return name
      .replace(/[A-Z]/g, (char: string, offset: number) => (offset > 0 ? `-${char}` : char))
      .toLowerCase();
  }

  const totalComponents = NAV_ITEMS.reduce((acc, { components }) => acc + components.length, 0);

  let observer: IntersectionObserver | null = null;

  function setupObserver() {
    if (observer) observer.disconnect();
    activeAnchor = "";
    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    if (sections.length === 0) return;
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) activeAnchor = entry.target.id;
        }
      },
      { rootMargin: "-80px 0px -66% 0px" },
    );
    sections.forEach((s) => observer!.observe(s));
  }

  $effect(() => {
    // Re-run when the page URL changes
    void $page.url.pathname;
    setupObserver();
  });

  onDestroy(() => observer?.disconnect());

  function getActiveSlug(pathname: string) {
    return pathname.startsWith("/library/") ? pathname.slice("/library/".length) : "";
  }
</script>

<div class="flex flex-col h-full">
  <!-- Header -->
  <div class="flex items-center gap-2 px-3 border-b border-base-300 flex-shrink-0" style="height: 56px;">
    <span class="text-primary">
      <svg fill="none" height="20" viewBox="0 0 20 20" width="20">
        <rect fill="currentColor" height="7" opacity="0.9" rx="1.5" width="7" x="2" y="2" />
        <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="11" y="2" />
        <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="2" y="11" />
        <rect fill="currentColor" height="7" opacity="0.3" rx="1.5" width="7" x="11" y="11" />
      </svg>
    </span>
    <a
      class="font-semibold text-sm text-base-content no-underline hover:text-primary transition-colors"
      href="/library"
      onclick={onNavigate}
    >
      Component Library
    </a>
  </div>

  <!-- Nav list -->
  <div class="flex-grow overflow-y-auto py-2">
    {#each NAV_ITEMS as { category, components, slug } (slug)}
      {@const activeSlug = getActiveSlug($page.url.pathname)}
      {@const isCategoryActive = activeSlug === slug}
      <div class="px-2 py-1">
        <!-- Category link -->
        <a
          class={[
            "flex items-center gap-2 px-2 py-2 rounded-btn text-sm font-medium no-underline transition-colors",
            isCategoryActive
              ? "bg-primary text-primary-content"
              : "text-base-content hover:bg-base-200",
          ].join(" ")}
          href={`/library/${slug}`}
          onclick={onNavigate}
        >
          <span class="flex-grow">{category}</span>
          <span class="badge badge-sm badge-ghost">{components.length}</span>
        </a>

        <!-- Sub-items -->
        <ul class="list-none m-0 ms-3 mt-1 pl-3" style="border-left: 1px solid oklch(var(--b3));">
          {#each components as component (component)}
            {@const componentSlug = toSlug(component)}
            {@const isAnchorActive = isCategoryActive && activeAnchor === componentSlug}
            <li>
              <a
                class={[
                  "block px-2 py-1 rounded text-sm no-underline transition-colors",
                  isAnchorActive
                    ? "font-semibold text-primary"
                    : "text-base-content/60 hover:text-base-content",
                ].join(" ")}
                href={`/library/${slug}#${componentSlug}`}
                onclick={onNavigate}
              >
                {component}
              </a>
            </li>
          {/each}
        </ul>
      </div>
    {/each}
  </div>

  <!-- Footer -->
  <div class="px-3 py-2 border-t border-base-300 flex-shrink-0">
    <small class="text-base-content/50 text-xs">{totalComponents} components</small>
  </div>
</div>
