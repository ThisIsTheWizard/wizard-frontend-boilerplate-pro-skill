<script setup lang="ts">
import { computed, ref } from "vue";

import {
  CartesianGrid,
  Line,
  LineChart,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";

import { CodeBlock } from "@/components/ui/code-block";

const CHART_DATA = [
  { desktop: 186, mobile: 80, month: "Jan" },
  { desktop: 305, mobile: 200, month: "Feb" },
  { desktop: 237, mobile: 120, month: "Mar" },
  { desktop: 73, mobile: 190, month: "Apr" },
  { desktop: 209, mobile: 130, month: "May" },
  { desktop: 214, mobile: 140, month: "Jun" },
];

interface User {
  email: string;
  id: string;
  name: string;
  role: string;
}

type SortDir = "asc" | "desc";
type SortKey = keyof Omit<User, "id">;

const TABLE_DATA: User[] = [
  { email: "alice@example.com", id: "1", name: "Alice Johnson", role: "Admin" },
  { email: "bob@example.com", id: "2", name: "Bob Smith", role: "Editor" },
  { email: "carol@example.com", id: "3", name: "Carol White", role: "Viewer" },
  { email: "dan@example.com", id: "4", name: "Dan Lee", role: "Editor" },
  { email: "eve@example.com", id: "5", name: "Eve Martinez", role: "Viewer" },
];

const sortKey = ref<SortKey>("name");
const sortDir = ref<SortDir>("asc");

function handleSort(key: SortKey) {
  if (sortKey.value === key) {
    sortDir.value = sortDir.value === "asc" ? "desc" : "asc";
  } else {
    sortKey.value = key;
    sortDir.value = "asc";
  }
}

const sortedData = computed(() =>
  [...TABLE_DATA].sort((a, b) => {
    const result = a[sortKey.value].localeCompare(b[sortKey.value]);
    return sortDir.value === "asc" ? result : -result;
  }),
);

function sortIndicator(key: SortKey) {
  return sortKey.value === key ? (sortDir.value === "asc" ? " ↑" : " ↓") : "";
}

const CHART_CODE = `// DaisyUI has no chart primitive — use recharts directly.
import { CartesianGrid, Line, LineChart, ResponsiveContainer, Tooltip, XAxis, YAxis } from "recharts";

const DATA = [
  { desktop: 186, mobile: 80, month: "Jan" },
  { desktop: 305, mobile: 200, month: "Feb" },
  { desktop: 237, mobile: 120, month: "Mar" },
  { desktop: 73, mobile: 190, month: "Apr" },
  { desktop: 209, mobile: 130, month: "May" },
  { desktop: 214, mobile: 140, month: "Jun" },
];`;

const DATA_TABLE_CODE = `<script setup lang="ts">
import { computed, ref } from "vue";
type SortDir = "asc" | "desc";
type SortKey = "email" | "name" | "role";
const sortKey = ref<SortKey>("name");
const sortDir = ref<SortDir>("asc");
function handleSort(key: SortKey) {
  if (sortKey.value === key) sortDir.value = sortDir.value === "asc" ? "desc" : "asc";
  else { sortKey.value = key; sortDir.value = "asc"; }
}
<\/script>

<template>
  <div class="overflow-x-auto">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th v-for="key in ['name', 'email', 'role']" :key="key"
            class="cursor-pointer select-none hover:text-primary"
            @click="handleSort(key)">
            {{ key.charAt(0).toUpperCase() + key.slice(1) }}
            {{ sortKey === key ? (sortDir === 'asc' ? '↑' : '↓') : '' }}
          </th>
        </tr>
      </thead>
      <tbody>
        <tr v-for="row in sortedData" :key="row.id">
          <td>{{ row.name }}</td>
          <td>{{ row.email }}</td>
          <td>{{ row.role }}</td>
        </tr>
      </tbody>
    </table>
  </div>
</template>`;

const CALENDAR_CODE = `// DaisyUI has no built-in date picker.
// For Vue, use v-calendar: npm install v-calendar @popperjs/core
// Or use a headless date library with DaisyUI styles.

import { Calendar, DatePicker } from "v-calendar";
import "v-calendar/style.css";`;
</script>

<template>
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="text-xl font-semibold mb-1">Data viz</h1>
      <p class="text-base-content/60 text-sm">
        Charts, sortable tables, and date selection — using recharts, DaisyUI table classes,
        and v-calendar.
      </p>
    </div>

    <!-- Chart -->
    <section id="chart" class="mb-2">
      <div class="mb-2 pl-3" style="border-left: 3px solid var(--color-primary)">
        <h5 class="font-semibold mb-1">Chart</h5>
        <p class="text-base-content/60 text-sm mb-0">
          DaisyUI does not ship a chart component. Use <strong>recharts</strong> directly.
          Reference <code class="kbd kbd-sm">var(--color-primary)</code> and
          <code class="kbd kbd-sm">var(--color-secondary)</code> for colours to stay
          in sync with the active DaisyUI theme.
        </p>
      </div>
      <div class="bg-base-200 rounded-box p-4 mb-3">
        <ResponsiveContainer :height="256" width="100%">
          <LineChart :data="CHART_DATA">
            <CartesianGrid stroke-dasharray="3 3" />
            <XAxis data-key="month" />
            <YAxis />
            <Tooltip />
            <Line data-key="desktop" name="Desktop" stroke="var(--color-primary)" type="monotone" />
            <Line data-key="mobile" name="Mobile" stroke="var(--color-secondary)" type="monotone" />
          </LineChart>
        </ResponsiveContainer>
      </div>
      <CodeBlock :code="CHART_CODE" collapsible :default-open="false" filename="Chart.vue" language="vue" />
    </section>

    <div class="divider my-2" />

    <!-- DataTable -->
    <section id="data-table" class="mb-2">
      <div class="mb-2 pl-3" style="border-left: 3px solid var(--color-primary)">
        <h5 class="font-semibold mb-1">DataTable</h5>
        <p class="text-base-content/60 text-sm mb-0">
          A sortable table using <code class="kbd kbd-sm">table table-zebra</code>
          with client-side sorting via <code class="kbd kbd-sm">computed</code>.
          Click column headers to toggle order.
        </p>
      </div>
      <div class="bg-base-200 rounded-box p-4 mb-3">
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th
                  v-for="key in ['name', 'email', 'role'] as SortKey[]"
                  :key="key"
                  class="cursor-pointer select-none hover:text-primary"
                  @click="handleSort(key)"
                >
                  {{ key.charAt(0).toUpperCase() + key.slice(1) }}{{ sortIndicator(key) }}
                </th>
              </tr>
            </thead>
            <tbody>
              <tr v-for="row in sortedData" :key="row.id">
                <td>{{ row.name }}</td>
                <td>{{ row.email }}</td>
                <td>{{ row.role }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <CodeBlock :code="DATA_TABLE_CODE" collapsible :default-open="false" filename="DataTable.vue" language="vue" />
    </section>

    <div class="divider my-2" />

    <!-- Calendar -->
    <section id="calendar" class="mb-2">
      <div class="mb-2 pl-3" style="border-left: 3px solid var(--color-primary)">
        <h5 class="font-semibold mb-1">Calendar</h5>
        <p class="text-base-content/60 text-sm mb-0">
          DaisyUI has no built-in date picker. For Vue, use
          <strong>v-calendar</strong>:
        </p>
        <code class="text-xs mt-1 block">npm install v-calendar @popperjs/core</code>
      </div>
      <div class="bg-base-200 rounded-box p-4 mb-3">
        <p class="text-base-content/60 text-sm mb-0">
          Calendar preview omitted — <code class="kbd kbd-sm">v-calendar</code> requires
          importing its CSS alongside the component. See the code snippet below for the
          full setup.
        </p>
      </div>
      <CodeBlock :code="CALENDAR_CODE" collapsible :default-open="false" filename="Calendar.vue" language="vue" />
    </section>
  </div>
</template>
