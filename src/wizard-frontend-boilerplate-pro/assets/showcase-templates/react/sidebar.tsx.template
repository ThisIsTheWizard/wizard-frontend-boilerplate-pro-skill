      fill="none"
      height="22"
      viewBox="0 0 20 20"
      width="22"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect fill="currentColor" height="7" opacity="1" rx="1.5" width="7" x="2" y="2" />
      <rect fill="currentColor" height="7" opacity="0.65" rx="1.5" width="7" x="11" y="2" />
      <rect fill="currentColor" height="7" opacity="0.65" rx="1.5" width="7" x="2" y="11" />
      <rect fill="currentColor" height="7" opacity="0.3" rx="1.5" width="7" x="11" y="11" />
    </svg>
  );
}

