function LayersIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="15" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="15" xmlns="http://www.w3.org/2000/svg">
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </svg>
  );
}

const NAV_ITEMS: NavItem[] = [
  {
    category: "Data viz",
    components: ["Chart", "DataTable", "Calendar"],
    icon: BarChartIcon,
    slug: "data-viz",
  },
  {
    category: "Display",
    components: ["Card", "Badge", "Avatar", "Separator", "Skeleton", "Table"],
    icon: SquaresIcon,
    slug: "display",
  },
  {
    category: "Feedback",
    components: ["Alert", "Toast", "Progress", "Tooltip", "Dialog"],
    icon: BellIcon,
    slug: "feedback",
  },
  {
    category: "Inputs",
    components: ["Button", "Input", "Textarea", "Select", "Checkbox", "RadioGroup", "Switch"],
    icon: CursorIcon,
    slug: "inputs",
  },
  {
    category: "Navigation",
    components: ["Tabs", "Breadcrumb", "Pagination", "NavigationMenu"],
    icon: CompassIcon,
    slug: "navigation",
  },
  {
    category: "Overlay",
    components: ["Popover", "DropdownMenu", "Sheet"],
    icon: LayersIcon,
    slug: "overlay",
  },
];

const TOTAL_COMPONENTS = NAV_ITEMS.reduce(
  (acc, { components }) => acc + components.length,
  0,
);

function toSlug(name: string): string {
  return name
    .replace(/[A-Z]/g, (char, offset: number) => (offset > 0 ? `-${char}` : char))
    .toLowerCase();
}

export function Sidebar({ onNavigate }: SidebarProps) {
  const pathname = usePathname();
  const [activeAnchor, setActiveAnchor] = useState("");
  const [filterQuery, setFilterQuery] = useState("");

  const activeSlug = pathname.startsWith("/library/")
    ? pathname.slice("/library/".length)
    : "";

  const filteredNavItems =
    filterQuery.trim() === ""
      ? NAV_ITEMS
      : NAV_ITEMS.flatMap(({ category, components, icon, slug }) => {
          const q = filterQuery.toLowerCase();
          const categoryMatches = category.toLowerCase().includes(q);
          const matchedComponents = components.filter((c) =>
            c.toLowerCase().includes(q),
          );
          if (!categoryMatches && matchedComponents.length === 0) return [];
          return [
            {
              category,
              components: categoryMatches ? components : matchedComponents,
              icon,
              slug,
            },
          ];
        });

  useEffect(() => {
    setActiveAnchor("");

    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    if (sections.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveAnchor(entry.target.id);
          }
        }
      },
      { rootMargin: "-80px 0px -66% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
    return () => observer.disconnect();
  }, [pathname]);

  return (
    <nav
      aria-label="Component library navigation"
      className="flex h-full flex-col"
    >
      <div className="flex h-16 shrink-0 items-center gap-2.5 border-b border-border px-4">
        <span className="text-primary">
          <LogoIcon />
        </span>
        <div className="flex flex-col gap-0">
          <Link
            className="text-sm font-semibold leading-tight text-foreground transition-colors duration-150 hover:text-primary"
            href="/library"
            onClick={onNavigate}
          >
            Component Library
          </Link>
          <span className="text-[10px] leading-tight text-muted-foreground">
            shadcn/ui · Next.js · Tailwind
          </span>
        </div>
      </div>

      <div className="shrink-0 border-b border-border p-2">
        <div className="relative flex items-center">
          <span className="pointer-events-none absolute left-2.5 text-muted-foreground">
            <SearchIcon />
          </span>
          <input
            aria-label="Filter components"
            className="h-8 w-full rounded-md border border-border bg-muted/40 pl-8 pr-7 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary/50 focus:bg-background focus:outline-none focus:ring-1 focus:ring-primary/30 transition-colors duration-150"
            onChange={(e) => setFilterQuery(e.target.value)}
            placeholder="Filter components…"
            type="search"
            value={filterQuery}
          />
          {filterQuery && (
            <button
              aria-label="Clear filter"
              className="absolute right-2 cursor-pointer text-muted-foreground transition-colors duration-150 hover:text-foreground focus-visible:outline-none"
              onClick={() => setFilterQuery("")}
              type="button"
            >
              <XIcon />
            </button>
          )}
        </div>
      </div>

      <div className="flex-1 overflow-y-auto py-2">
        {filteredNavItems.length === 0 ? (
          <p className="px-4 py-6 text-center text-xs text-muted-foreground">
            No components match &ldquo;{filterQuery}&rdquo;
          </p>
        ) : (
          filteredNavItems.map(({ category, components, icon: Icon, slug }) => {
            const isCategoryActive = activeSlug === slug;

            return (
              <div className="px-2 py-0.5" key={slug}>
                <Link
                  className={cn(
                    "flex cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 text-sm font-medium transition-colors duration-150 hover:bg-accent hover:text-foreground",
                    isCategoryActive
                      ? "bg-primary/10 text-primary ring-inset ring-1 ring-primary/20"
                      : "text-muted-foreground",
                  )}
                  href={`/library/${slug}`}
                  onClick={onNavigate}
                >
                  <Icon />
                  <span className="flex-1">{category}</span>
                  <span
                    className={cn(
                      "rounded-full px-1.5 py-0.5 text-[10px] font-semibold tabular-nums",
                      isCategoryActive
                        ? "bg-primary text-primary-foreground"
                        : "bg-muted text-muted-foreground",
                    )}
                  >
                    {components.length}
                  </span>
                </Link>

                <div className="ml-4 mt-0.5 space-y-0.5 border-l border-border pl-3">
                  {components.map((component) => {
                    const componentSlug = toSlug(component);
                    const isAnchorActive =
                      isCategoryActive && activeAnchor === componentSlug;

                    return (
                      <Link
                        className={cn(
                          "block cursor-pointer rounded-md px-2 py-1 text-[13px] transition-colors duration-150 hover:bg-accent/60 hover:text-foreground",
                          isAnchorActive
                            ? "bg-accent font-medium text-foreground"
                            : "text-muted-foreground",
                        )}
                        href={`/library/${slug}#${componentSlug}`}
                        key={componentSlug}
                        onClick={onNavigate}
                      >
                        {component}
                      </Link>
                    );
                  })}
                </div>
              </div>
            );
          })
        )}
      </div>

      <div className="shrink-0 border-t border-border px-4 py-3">
        <div className="flex items-center justify-between">
          <p className="text-[11px] text-muted-foreground">
            <span className="font-medium text-foreground">{TOTAL_COMPONENTS}</span>{" "}
            components
          </p>
          <a
            className="cursor-pointer text-[11px] text-muted-foreground transition-colors duration-150 hover:text-foreground"
            href="#"
            rel="noopener noreferrer"
            target="_blank"
          >
            View source
          </a>
        </div>
      </div>
    </nav>
  );
}
