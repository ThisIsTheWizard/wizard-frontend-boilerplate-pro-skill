"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";

import { cn } from "@/lib/utils";

interface NavItem {
  category: string;
  components: string[];
  icon: React.FC;
  slug: string;
}

interface SidebarProps {
  onNavigate?: () => void;
}

