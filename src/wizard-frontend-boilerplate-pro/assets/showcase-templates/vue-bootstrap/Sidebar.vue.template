<script setup lang="ts">
import { computed, onMounted, onUnmounted, ref, watch } from "vue";
import { useRoute } from "vue-router";

import { BBadge } from "bootstrap-vue-next";

interface NavItem {
  category: string;
  components: string[];
  slug: string;
}

interface Props {
  onNavigate?: () => void;
}

const props = withDefaults(defineProps<Props>(), {
  onNavigate: undefined,
});

const NAV_ITEMS: NavItem[] = [
  {
    category: "Data viz",
    components: ["Chart", "DataTable", "Calendar"],
    slug: "data-viz",
  },
  {
    category: "Display",
    components: ["Card", "Badge", "Avatar", "Separator", "Skeleton", "Table"],
    slug: "display",
  },
  {
    category: "Feedback",
    components: ["Alert", "Toast", "Progress", "Tooltip", "Dialog"],
    slug: "feedback",
  },
  {
    category: "Inputs",
    components: [
      "Button",
      "Input",
      "Textarea",
      "Select",
      "Checkbox",
      "RadioGroup",
      "Switch",
    ],
    slug: "inputs",
  },
  {
    category: "Navigation",
    components: ["Tabs", "Breadcrumb", "Pagination", "NavigationMenu"],
    slug: "navigation",
  },
  {
    category: "Overlay",
    components: ["Popover", "DropdownMenu", "Sheet"],
    slug: "overlay",
  },
];

const CATEGORY_ICONS: Record<string, string> = {
  "data-viz": `<svg aria-hidden="true" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24" width="16"><rect height="12" rx="1" width="4" x="3" y="9"/><rect height="18" rx="1" width="4" x="10" y="3"/><rect height="8" rx="1" width="4" x="17" y="13"/></svg>`,
  display: `<svg aria-hidden="true" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24" width="16"><rect height="7" rx="1.5" width="7" x="3" y="3"/><rect height="7" rx="1.5" width="7" x="14" y="3"/><rect height="7" rx="1.5" width="7" x="3" y="14"/><rect height="7" rx="1.5" width="7" x="14" y="14"/></svg>`,
  feedback: `<svg aria-hidden="true" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24" width="16"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>`,
  inputs: `<svg aria-hidden="true" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24" width="16"><path d="m4 4 7.07 17 2.51-7.39L21 11.07z"/></svg>`,
  navigation: `<svg aria-hidden="true" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24" width="16"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
  overlay: `<svg aria-hidden="true" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24" width="16"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
};

const totalComponents = NAV_ITEMS.reduce((acc, { components }) => acc + components.length, 0);

function toSlug(name: string): string {
  return name
    .replace(/[A-Z]/g, (char, offset: number) => (offset > 0 ? `-${char}` : char))
    .toLowerCase();
}

const route = useRoute();
const activeAnchor = ref("");

const activeSlug = computed(() =>
  route.path.startsWith("/library/") ? route.path.slice("/library/".length) : "",
);

let observer: IntersectionObserver | null = null;

function initObserver() {
  if (observer) {
    observer.disconnect();
    observer = null;
  }

  activeAnchor.value = "";

  const sections = document.querySelectorAll<HTMLElement>("section[id]");
  if (sections.length === 0) return;

  observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          activeAnchor.value = entry.target.id;
        }
      }
    },
    { rootMargin: "-80px 0px -66% 0px" },
  );

  sections.forEach((section) => observer!.observe(section));
}

onMounted(() => {
  initObserver();
});

onUnmounted(() => {
  if (observer) {
    observer.disconnect();
    observer = null;
  }
});

watch(
  () => route.path,
  () => {
    initObserver();
  },
);
</script>

<template>
  <nav aria-label="Component library navigation" class="d-flex flex-column h-100">
    <!-- Brand header -->
    <div
      class="d-flex align-items-center gap-2 px-3 flex-shrink-0"
      style="
        border-bottom: 1px solid var(--bs-border-color);
        height: 56px;
      "
    >
      <svg
        aria-hidden="true"
        fill="none"
        height="20"
        style="color: var(--bs-primary)"
        viewBox="0 0 20 20"
        width="20"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect fill="currentColor" height="7" opacity="0.9" rx="1.5" width="7" x="2" y="2" />
        <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="11" y="2" />
        <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="2" y="11" />
        <rect fill="currentColor" height="7" opacity="0.3" rx="1.5" width="7" x="11" y="11" />
      </svg>
      <RouterLink
        class="text-decoration-none fw-semibold small"
        style="color: var(--bs-body-color)"
        to="/library"
        @click="props.onNavigate?.()"
      >
        Component Library
      </RouterLink>
    </div>

    <!-- Nav items -->
    <div class="flex-grow-1 overflow-auto py-2">
      <div
        v-for="{ category, components, slug } in NAV_ITEMS"
        :key="slug"
        class="px-2 py-1"
      >
        <!-- Category link -->
        <RouterLink
          :class="[
            'd-flex align-items-center gap-2 rounded px-2 py-2 text-decoration-none small fw-medium',
            activeSlug === slug
              ? 'text-primary'
              : 'text-body-secondary',
          ]"
          :style="
            activeSlug === slug
              ? 'background: rgba(var(--bs-primary-rgb), 0.1)'
              : ''
          "
          :to="`/library/${slug}`"
          @click="props.onNavigate?.()"
        >
          <!-- eslint-disable-next-line vue/no-v-html -->
          <span v-html="CATEGORY_ICONS[slug]" />
          <span class="flex-grow-1">{{ category }}</span>
          <BBadge
            :variant="activeSlug === slug ? 'primary' : 'secondary'"
            pill
          >
            {{ components.length }}
          </BBadge>
        </RouterLink>

        <!-- Sub-items -->
        <div
          class="ms-4 mt-1"
          style="border-left: 1px solid var(--bs-border-color); padding-left: 0.75rem"
        >
          <RouterLink
            v-for="component in components"
            :key="toSlug(component)"
            :class="[
              'd-block rounded px-2 py-1 text-decoration-none small',
              activeSlug === slug && activeAnchor === toSlug(component)
                ? 'fw-medium text-body'
                : 'text-body-secondary',
            ]"
            :style="
              activeSlug === slug && activeAnchor === toSlug(component)
                ? 'background: var(--bs-secondary-bg)'
                : ''
            "
            :to="`/library/${slug}#${toSlug(component)}`"
            @click="props.onNavigate?.()"
          >
            {{ component }}
          </RouterLink>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div
      class="flex-shrink-0 px-4 py-3"
      style="border-top: 1px solid var(--bs-border-color)"
    >
      <p class="mb-0 text-body-secondary" style="font-size: 11px">
        {{ totalComponents }} components
      </p>
    </div>
  </nav>
</template>
