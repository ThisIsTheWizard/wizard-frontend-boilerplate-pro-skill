"use client";

import { useMemo, useState } from "react";
import {
  Bar,
  BarChart,
  CartesianGrid,
  Line,
  LineChart,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";
import {
  Table,
  TableBody,
  TableCell,
  TableColumn,
  TableHeader,
  TableRow,
} from "@heroui/react";

import { CodeBlock } from "@/components/ui/code-block";
import { cn } from "@/lib/utils";

const CHART_CODE = `import { Bar, BarChart, CartesianGrid, ResponsiveContainer, Tooltip, XAxis, YAxis } from "recharts";

const data = [
  { month: "Jan", revenue: 4200 },
  { month: "Feb", revenue: 5800 },
  { month: "Mar", revenue: 3900 },
  { month: "Apr", revenue: 7100 },
  { month: "May", revenue: 6400 },
  { month: "Jun", revenue: 8200 },
];

export function Example() {
  return (
    <ResponsiveContainer width="100%" height={220}>
      <BarChart data={data}>
        <CartesianGrid strokeDasharray="3 3" stroke="var(--color-border)" />
        <XAxis dataKey="month" tick={{ fontSize: 12, fill: "var(--color-muted-foreground)" }} axisLine={false} tickLine={false} />
        <YAxis tick={{ fontSize: 12, fill: "var(--color-muted-foreground)" }} axisLine={false} tickLine={false} />
        <Tooltip contentStyle={{ background: "var(--color-surface)", border: "1px solid var(--color-border)", borderRadius: 8 }} />
        <Bar dataKey="revenue" fill="var(--color-primary)" radius={[4, 4, 0, 0]} />
      </BarChart>
    </ResponsiveContainer>
  );
}`;

const DATA_TABLE_CODE = `import { useState } from "react";
import { Table, TableHeader, TableColumn, TableBody, TableRow, TableCell } from "@heroui/react";

const rows = [
  { name: "Alice Martin", status: "Active", revenue: "$12,400", change: "+8%" },
  { name: "Bob Chen",     status: "Active", revenue: "$9,800",  change: "+3%" },
  { name: "Carol White",  status: "Paused", revenue: "$6,200",  change: "-2%" },
];

export function Example() {
  const [sortAsc, setSortAsc] = useState(true);
  const sorted = [...rows].sort((a, b) =>
    sortAsc ? a.name.localeCompare(b.name) : b.name.localeCompare(a.name)
  );

  return (
    <Table aria-label="Revenue data" sortDescriptor={{ column: "name", direction: sortAsc ? "ascending" : "descending" }} onSortChange={() => setSortAsc((a) => !a)}>
      <TableHeader>
        <TableColumn key="name" allowsSorting>Name</TableColumn>
        <TableColumn key="status">Status</TableColumn>
        <TableColumn key="revenue">Revenue</TableColumn>
        <TableColumn key="change">Change</TableColumn>
      </TableHeader>
      <TableBody>
        {sorted.map((row) => (
          <TableRow key={row.name}>
            <TableCell>{row.name}</TableCell>
            <TableCell>{row.status}</TableCell>
            <TableCell>{row.revenue}</TableCell>
            <TableCell>{row.change}</TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  );
}`;

const CALENDAR_CODE = `import { useMemo, useState } from "react";
import { cn } from "@/lib/utils";

export function Example() {
  const today = new Date();
  const [current, setCurrent] = useState({ year: today.getFullYear(), month: today.getMonth() });

  const days = useMemo(() => {
    const first = new Date(current.year, current.month, 1);
    const last = new Date(current.year, current.month + 1, 0);
    const blanks = Array.from({ length: first.getDay() }, (_, i) => ({ day: 0, key: \`b-\${i}\` }));
    const filled = Array.from({ length: last.getDate() }, (_, i) => ({ day: i + 1, key: \`d-\${i + 1}\` }));
    return [...blanks, ...filled];
  }, [current]);

  return (
    <div className="w-72 rounded-xl border border-border bg-surface p-4">
      <div className="mb-3 flex items-center justify-between">
        <button onClick={() => setCurrent(({ year, month }) => month === 0 ? { year: year - 1, month: 11 } : { year, month: month - 1 })} className="rounded p-1 hover:bg-accent">◂</button>
        <span className="text-sm font-semibold text-foreground">{new Date(current.year, current.month).toLocaleString("default", { month: "long", year: "numeric" })}</span>
        <button onClick={() => setCurrent(({ year, month }) => month === 11 ? { year: year + 1, month: 0 } : { year, month: month + 1 })} className="rounded p-1 hover:bg-accent">▸</button>
      </div>
      <div className="grid grid-cols-7 gap-1 text-center text-xs text-muted-foreground">
        {["Su","Mo","Tu","We","Th","Fr","Sa"].map((d) => <div key={d}>{d}</div>)}
        {days.map(({ day, key }) => (
          <button key={key} disabled={!day} className={cn("rounded py-1 text-sm", !day && "invisible", day === today.getDate() && current.month === today.getMonth() && current.year === today.getFullYear() ? "bg-primary text-primary-foreground font-semibold" : "hover:bg-accent text-foreground")}>{day || ""}</button>
        ))}
      </div>
    </div>
  );
}`;

const REVENUE_DATA = [
  { month: "Jan", revenue: 4200, users: 320 },
  { month: "Feb", revenue: 5800, users: 410 },
  { month: "Mar", revenue: 3900, users: 280 },
  { month: "Apr", revenue: 7100, users: 540 },
  { month: "May", revenue: 6400, users: 490 },
  { month: "Jun", revenue: 8200, users: 620 },
];

const TABLE_ROWS = [
  { name: "Alice Martin", status: "Active", revenue: "$12,400", change: "+8%" },
  { name: "Bob Chen", status: "Active", revenue: "$9,800", change: "+3%" },
  { name: "Carol White", status: "Paused", revenue: "$6,200", change: "-2%" },
  { name: "Dan Kim", status: "Active", revenue: "$15,100", change: "+14%" },
  { name: "Eve Torres", status: "Paused", revenue: "$4,300", change: "-6%" },
];

export default function DataVizPage() {
  const today = new Date();
  const [current, setCurrent] = useState({
    year: today.getFullYear(),
    month: today.getMonth(),
  });
  const [sortAsc, setSortAsc] = useState(true);

  const sorted = useMemo(
    () =>
      [...TABLE_ROWS].sort((a, b) =>
        sortAsc
          ? a.name.localeCompare(b.name)
          : b.name.localeCompare(a.name),
      ),
    [sortAsc],
  );

  const days = useMemo(() => {
    const first = new Date(current.year, current.month, 1);
    const last = new Date(current.year, current.month + 1, 0);
    const blanks = Array.from({ length: first.getDay() }, (_, i) => ({
      day: 0,
      key: `b-${i}`,
    }));
    const filled = Array.from({ length: last.getDate() }, (_, i) => ({
      day: i + 1,
      key: `d-${i + 1}`,
    }));
    return [...blanks, ...filled];
  }, [current]);

  const monthLabel = new Date(current.year, current.month).toLocaleString(
    "default",
    { month: "long", year: "numeric" },
  );

  const prevMonth = () =>
    setCurrent(({ year, month }) =>
      month === 0 ? { year: year - 1, month: 11 } : { year, month: month - 1 },
    );
  const nextMonth = () =>
    setCurrent(({ year, month }) =>
      month === 11
        ? { year: year + 1, month: 0 }
        : { year, month: month + 1 },
    );

  return (
    <div className="flex flex-col gap-16">
      <div>
        <h1 className="text-3xl font-bold tracking-tight text-foreground">
          Data viz
        </h1>
        <p className="mt-2 text-muted-foreground">
          Data visualisation components — recharts for charts (HeroUI has no
          native chart), HeroUI{" "}
          <code className="rounded bg-muted px-1 py-0.5 text-xs">Table</code>{" "}
          for sortable data tables, and a plain calendar grid.
        </p>
      </div>

      <section className="flex flex-col gap-4" id="chart">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">Chart</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            Bar and line charts via{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">
              recharts
            </code>{" "}
            — HeroUI has no native chart component. Colours reference CSS custom
            properties so they honour the active theme.
          </p>
        </div>
        <div className="rounded-lg border border-border bg-muted/50 p-8">
          <div className="flex flex-col gap-8">
            <div>
              <p className="mb-3 text-sm font-medium text-foreground">
                Monthly Revenue
              </p>
              <ResponsiveContainer height={220} width="100%">
                <BarChart data={REVENUE_DATA}>
                  <CartesianGrid
                    stroke="var(--color-border)"
                    strokeDasharray="3 3"
                  />
                  <XAxis
                    axisLine={false}
                    dataKey="month"
                    tick={{
                      fill: "var(--color-muted-foreground)",
                      fontSize: 12,
                    }}
                    tickLine={false}
                  />
                  <YAxis
                    axisLine={false}
                    tick={{
                      fill: "var(--color-muted-foreground)",
                      fontSize: 12,
                    }}
                    tickLine={false}
                  />
                  <Tooltip
                    contentStyle={{
                      background: "var(--color-surface)",
                      border: "1px solid var(--color-border)",
                      borderRadius: 8,
                      color: "var(--color-foreground)",
                      fontSize: 12,
                    }}
                  />
                  <Bar
                    dataKey="revenue"
                    fill="var(--color-primary)"
                    radius={[4, 4, 0, 0]}
                  />
                </BarChart>
              </ResponsiveContainer>
            </div>
            <div>
              <p className="mb-3 text-sm font-medium text-foreground">
                New Users
              </p>
              <ResponsiveContainer height={180} width="100%">
                <LineChart data={REVENUE_DATA}>
                  <CartesianGrid
                    stroke="var(--color-border)"
                    strokeDasharray="3 3"
                  />
                  <XAxis
                    axisLine={false}
                    dataKey="month"
                    tick={{
                      fill: "var(--color-muted-foreground)",
                      fontSize: 12,
                    }}
                    tickLine={false}
                  />
                  <YAxis
                    axisLine={false}
                    tick={{
                      fill: "var(--color-muted-foreground)",
                      fontSize: 12,
                    }}
                    tickLine={false}
                  />
                  <Tooltip
                    contentStyle={{
                      background: "var(--color-surface)",
                      border: "1px solid var(--color-border)",
                      borderRadius: 8,
                      fontSize: 12,
                    }}
                  />
                  <Line
                    dataKey="users"
                    dot={{ fill: "var(--color-primary)", r: 4 }}
                    stroke="var(--color-primary)"
                    strokeWidth={2}
                    type="monotone"
                  />
                </LineChart>
              </ResponsiveContainer>
            </div>
          </div>
        </div>
        <CodeBlock
          code={CHART_CODE}
          collapsible
          defaultOpen={false}
          filename="Chart.tsx"
          language="tsx"
        />
      </section>

      <section className="flex flex-col gap-4" id="data-table">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">DataTable</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            HeroUI{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">Table</code>{" "}
            with sort state — use{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">allowsSorting</code>{" "}
            on{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">TableColumn</code>{" "}
            and bind{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">sortDescriptor</code>{" "}
            +{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">onSortChange</code>{" "}
            on the table.
          </p>
        </div>
        <div className="rounded-lg border border-border bg-muted/50 p-8">
          <Table
            aria-label="Revenue data"
            sortDescriptor={{
              column: "name",
              direction: sortAsc ? "ascending" : "descending",
            }}
            onSortChange={() => setSortAsc((a) => !a)}
          >
            <TableHeader>
              <TableColumn allowsSorting key="name">
                Name
              </TableColumn>
              <TableColumn key="status">Status</TableColumn>
              <TableColumn key="revenue">Revenue</TableColumn>
              <TableColumn key="change">Change</TableColumn>
            </TableHeader>
            <TableBody>
              {sorted.map((row) => (
                <TableRow key={row.name}>
                  <TableCell>{row.name}</TableCell>
                  <TableCell>
                    <span
                      className={cn(
                        "rounded-full px-2 py-0.5 text-xs font-medium",
                        row.status === "Active"
                          ? "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400"
                          : "bg-muted text-muted-foreground",
                      )}
                    >
                      {row.status}
                    </span>
                  </TableCell>
                  <TableCell>{row.revenue}</TableCell>
                  <TableCell
                    className={
                      row.change.startsWith("+")
                        ? "font-medium text-green-600 dark:text-green-400"
                        : "font-medium text-destructive"
                    }
                  >
                    {row.change}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
        <CodeBlock
          code={DATA_TABLE_CODE}
          collapsible
          defaultOpen={false}
          filename="DataTable.tsx"
          language="tsx"
        />
      </section>

      <section className="flex flex-col gap-4" id="calendar">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">Calendar</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            A month-view calendar grid with previous/next navigation — plain
            grid layout. For a full date-picker use HeroUI{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">
              DatePicker
            </code>{" "}
            from{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">
              @heroui/date-picker
            </code>
            .
          </p>
        </div>
        <div className="rounded-lg border border-border bg-muted/50 p-8">
          <div className="w-72 rounded-xl border border-border bg-surface p-4">
            <div className="mb-3 flex items-center justify-between">
              <button
                className="rounded p-1 text-muted-foreground transition hover:bg-accent hover:text-foreground"
                onClick={prevMonth}
                type="button"
              >
                ◂
              </button>
              <span className="text-sm font-semibold text-foreground">
                {monthLabel}
              </span>
              <button
                className="rounded p-1 text-muted-foreground transition hover:bg-accent hover:text-foreground"
                onClick={nextMonth}
                type="button"
              >
                ▸
              </button>
            </div>
            <div className="grid grid-cols-7 gap-1 text-center text-xs text-muted-foreground">
              {["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"].map((d) => (
                <div key={d}>{d}</div>
              ))}
              {days.map(({ day, key }) => {
                const isToday =
                  day === today.getDate() &&
                  current.month === today.getMonth() &&
                  current.year === today.getFullYear();
                return (
                  <button
                    className={cn(
                      "rounded py-1 text-sm transition",
                      !day && "invisible",
                      isToday
                        ? "bg-primary font-semibold text-primary-foreground"
                        : "text-foreground hover:bg-accent",
                    )}
                    disabled={!day}
                    key={key}
                    type="button"
                  >
                    {day || ""}
                  </button>
                );
              })}
            </div>
          </div>
        </div>
        <CodeBlock
          code={CALENDAR_CODE}
          collapsible
          defaultOpen={false}
          filename="Calendar.tsx"
          language="tsx"
        />
      </section>
    </div>
  );
}
