"use client";

import { useCallback, useState } from "react";
import {
  Modal,
  ModalBody,
  ModalContent,
  ModalFooter,
  ModalHeader,
  Progress,
  Tooltip,
  useDisclosure,
} from "@heroui/react";

import { CodeBlock } from "@/components/ui/code-block";

const ALERT_CODE = `export function Example() {
  return (
    <div className="flex flex-col gap-3">
      <div role="alert" className="flex items-start gap-3 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800 dark:border-blue-800 dark:bg-blue-950/30 dark:text-blue-300">
        <span className="mt-0.5 shrink-0">ℹ</span>
        <div><p className="font-medium">Info</p><p className="mt-0.5 opacity-80">Your session expires in 30 minutes.</p></div>
      </div>
      <div role="alert" className="flex items-start gap-3 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 dark:border-green-800 dark:bg-green-950/30 dark:text-green-300">
        <span className="mt-0.5 shrink-0">✓</span>
        <div><p className="font-medium">Success</p><p className="mt-0.5 opacity-80">Your changes have been saved.</p></div>
      </div>
    </div>
  );
}`;

const TOAST_CODE = `import { useCallback, useState } from "react";

let id = 0;

export function Example() {
  const [toasts, setToasts] = useState<Array<{ id: number; message: string }>>([]);

  const show = useCallback((message: string) => {
    const toastId = ++id;
    setToasts((prev) => [...prev, { id: toastId, message }]);
    setTimeout(() => setToasts((prev) => prev.filter((t) => t.id !== toastId)), 3000);
  }, []);

  return (
    <>
      <button onClick={() => show("Action completed successfully!")} className="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:opacity-90">
        Show toast
      </button>
      <div className="fixed bottom-4 right-4 z-50 flex flex-col gap-2">
        {toasts.map((t) => (
          <div key={t.id} className="rounded-lg border border-border bg-surface px-4 py-3 text-sm text-foreground shadow-lg">
            {t.message}
          </div>
        ))}
      </div>
    </>
  );
}`;

const PROGRESS_CODE = `import { Progress } from "@heroui/react";

export function Example() {
  return (
    <div className="flex flex-col gap-4">
      <Progress color="primary" label="Upload progress" value={72} showValueLabel />
      <Progress color="success" label="Storage used" value={40} showValueLabel />
      <Progress color="primary" isIndeterminate label="Loading…" />
    </div>
  );
}`;

const TOOLTIP_CODE = `import { Tooltip, Button } from "@heroui/react";

export function Example() {
  return (
    <div className="flex flex-wrap gap-4">
      <Tooltip content="Tooltip on top" placement="top">
        <Button variant="bordered">Top</Button>
      </Tooltip>
      <Tooltip content="Tooltip on bottom" placement="bottom">
        <Button variant="bordered">Bottom</Button>
      </Tooltip>
      <Tooltip content="Tooltip on left" placement="left">
        <Button variant="bordered">Left</Button>
      </Tooltip>
      <Tooltip content="Tooltip on right" placement="right">
        <Button variant="bordered">Right</Button>
      </Tooltip>
    </div>
  );
}`;

const MODAL_CODE = `import { useDisclosure, Modal, ModalContent, ModalHeader, ModalBody, ModalFooter, Button } from "@heroui/react";

export function Example() {
  const { isOpen, onOpen, onClose } = useDisclosure();

  return (
    <>
      <Button color="primary" onPress={onOpen}>Open modal</Button>
      <Modal isOpen={isOpen} onClose={onClose}>
        <ModalContent>
          <ModalHeader>Delete project?</ModalHeader>
          <ModalBody>
            <p className="text-sm text-muted-foreground">
              This action cannot be undone. All data will be permanently removed.
            </p>
          </ModalBody>
          <ModalFooter>
            <Button variant="light" onPress={onClose}>Cancel</Button>
            <Button color="danger" onPress={onClose}>Delete</Button>
          </ModalFooter>
        </ModalContent>
      </Modal>
    </>
  );
}`;

let toastId = 0;

export default function FeedbackPage() {
  const [toasts, setToasts] = useState<Array<{ id: number; message: string }>>(
    [],
  );
  const { isOpen, onOpen, onClose } = useDisclosure();

  const showToast = useCallback((message: string) => {
    const id = ++toastId;
    setToasts((prev) => [...prev, { id, message }]);
    setTimeout(
      () => setToasts((prev) => prev.filter((t) => t.id !== id)),
      3000,
    );
  }, []);

  return (
    <div className="flex flex-col gap-16">
      <div>
        <h1 className="text-3xl font-bold tracking-tight text-foreground">
          Feedback
        </h1>
        <p className="mt-2 text-muted-foreground">
          Status indicators and interactive feedback — alerts, toasts, progress
          bars, tooltips, and modals. HeroUI provides{" "}
          <code className="rounded bg-muted px-1 py-0.5 text-xs">Progress</code>,{" "}
          <code className="rounded bg-muted px-1 py-0.5 text-xs">Tooltip</code>, and{" "}
          <code className="rounded bg-muted px-1 py-0.5 text-xs">Modal</code>; alerts
          and toasts use plain state management.
        </p>
      </div>

      <section className="flex flex-col gap-4" id="alert">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">Alert</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            HeroUI has no native Alert component. Use{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">
              role=&quot;alert&quot;
            </code>{" "}
            with semantic colour variants via Tailwind.
          </p>
        </div>
        <div className="rounded-lg border border-border bg-muted/50 p-8">
          <div className="flex flex-col gap-3">
            <div
              className="flex items-start gap-3 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800 dark:border-blue-800 dark:bg-blue-950/30 dark:text-blue-300"
              role="alert"
            >
              <span className="mt-0.5 shrink-0">ℹ</span>
              <div>
                <p className="font-medium">Info</p>
                <p className="mt-0.5 opacity-80">
                  Your session expires in 30 minutes.
                </p>
              </div>
            </div>
            <div
              className="flex items-start gap-3 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 dark:border-green-800 dark:bg-green-950/30 dark:text-green-300"
              role="alert"
            >
              <span className="mt-0.5 shrink-0">✓</span>
              <div>
                <p className="font-medium">Success</p>
                <p className="mt-0.5 opacity-80">
                  Your changes have been saved.
                </p>
              </div>
            </div>
            <div
              className="flex items-start gap-3 rounded-lg border border-yellow-200 bg-yellow-50 px-4 py-3 text-sm text-yellow-800 dark:border-yellow-800 dark:bg-yellow-950/30 dark:text-yellow-300"
              role="alert"
            >
              <span className="mt-0.5 shrink-0">⚠</span>
              <div>
                <p className="font-medium">Warning</p>
                <p className="mt-0.5 opacity-80">
                  This will affect all team members.
                </p>
              </div>
            </div>
            <div
              className="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-800 dark:bg-red-950/30 dark:text-red-300"
              role="alert"
            >
              <span className="mt-0.5 shrink-0">✕</span>
              <div>
                <p className="font-medium">Error</p>
                <p className="mt-0.5 opacity-80">
                  Something went wrong. Please try again.
                </p>
              </div>
            </div>
          </div>
        </div>
        <CodeBlock
          code={ALERT_CODE}
          collapsible
          defaultOpen={false}
          filename="Alert.tsx"
          language="tsx"
        />
      </section>

      <section className="flex flex-col gap-4" id="toast">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">Toast</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            HeroUI has no native Toast component. Use an ephemeral notification
            queue managed with{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">
              useState
            </code>{" "}
            and auto-dismissed after 3 seconds.
          </p>
        </div>
        <div className="rounded-lg border border-border bg-muted/50 p-8">
          <button
            className="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition hover:opacity-90"
            onClick={() => showToast("Action completed successfully!")}
            type="button"
          >
            Show toast
          </button>
        </div>
        <CodeBlock
          code={TOAST_CODE}
          collapsible
          defaultOpen={false}
          filename="Toast.tsx"
          language="tsx"
        />
      </section>

      <section className="flex flex-col gap-4" id="progress">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">Progress</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            HeroUI{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">Progress</code>{" "}
            — pass{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">value</code>{" "}
            (0–100), optionally{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">showValueLabel</code>,{" "}
            or{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">isIndeterminate</code>{" "}
            for loading states.
          </p>
        </div>
        <div className="rounded-lg border border-border bg-muted/50 p-8">
          <div className="flex max-w-sm flex-col gap-6">
            <Progress
              color="primary"
              label="Upload progress"
              showValueLabel
              value={72}
            />
            <Progress
              color="success"
              label="Storage used"
              showValueLabel
              value={40}
            />
            <Progress
              color="primary"
              isIndeterminate
              label="Loading…"
            />
          </div>
        </div>
        <CodeBlock
          code={PROGRESS_CODE}
          collapsible
          defaultOpen={false}
          filename="Progress.tsx"
          language="tsx"
        />
      </section>

      <section className="flex flex-col gap-4" id="tooltip">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">Tooltip</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            HeroUI{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">Tooltip</code>{" "}
            wraps any element and shows contextual hints. Use the{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">placement</code>{" "}
            prop for positioning.
          </p>
        </div>
        <div className="rounded-lg border border-border bg-muted/50 p-8">
          <div className="flex flex-wrap gap-4">
            <Tooltip content="Tooltip on top" placement="top">
              <button className="rounded-md border border-border px-3 py-1.5 text-sm hover:bg-accent">
                Top
              </button>
            </Tooltip>
            <Tooltip content="Tooltip on bottom" placement="bottom">
              <button className="rounded-md border border-border px-3 py-1.5 text-sm hover:bg-accent">
                Bottom
              </button>
            </Tooltip>
            <Tooltip content="Tooltip on left" placement="left">
              <button className="rounded-md border border-border px-3 py-1.5 text-sm hover:bg-accent">
                Left
              </button>
            </Tooltip>
            <Tooltip content="Tooltip on right" placement="right">
              <button className="rounded-md border border-border px-3 py-1.5 text-sm hover:bg-accent">
                Right
              </button>
            </Tooltip>
          </div>
        </div>
        <CodeBlock
          code={TOOLTIP_CODE}
          collapsible
          defaultOpen={false}
          filename="Tooltip.tsx"
          language="tsx"
        />
      </section>

      <section className="flex flex-col gap-4" id="modal">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">Modal</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            HeroUI{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">Modal</code>{" "}
            — use{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">useDisclosure()</code>{" "}
            for open/close state.{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-xs">ModalContent</code>{" "}
            must wrap all sub-components.
          </p>
        </div>
        <div className="rounded-lg border border-border bg-muted/50 p-8">
          <button
            className="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition hover:opacity-90"
            onClick={onOpen}
            type="button"
          >
            Open modal
          </button>
          <Modal isOpen={isOpen} onClose={onClose}>
            <ModalContent>
              <ModalHeader>Delete project?</ModalHeader>
              <ModalBody>
                <p className="text-sm text-muted-foreground">
                  This action cannot be undone. All data will be permanently
                  removed.
                </p>
              </ModalBody>
              <ModalFooter>
                <button
                  className="rounded-md border border-border px-4 py-2 text-sm font-medium text-foreground transition hover:bg-accent"
                  onClick={onClose}
                  type="button"
                >
                  Cancel
                </button>
                <button
                  className="rounded-md bg-destructive px-4 py-2 text-sm font-medium text-white transition hover:opacity-90"
                  onClick={onClose}
                  type="button"
                >
                  Delete
                </button>
              </ModalFooter>
            </ModalContent>
          </Modal>
        </div>
        <CodeBlock
          code={MODAL_CODE}
          collapsible
          defaultOpen={false}
          filename="Modal.tsx"
          language="tsx"
        />
      </section>

      {toasts.length > 0 && (
        <div className="fixed bottom-4 right-4 z-50 flex flex-col gap-2">
          {toasts.map((t) => (
            <div
              className="rounded-lg border border-border bg-surface px-4 py-3 text-sm text-foreground shadow-lg"
              key={t.id}
            >
              {t.message}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
