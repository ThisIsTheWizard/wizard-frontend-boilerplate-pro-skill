const NAV_ITEMS: NavItem[] = [
  {
    category: "Data viz",
    components: ["Chart", "DataTable", "Calendar"],
    icon: BarChartIcon,
    slug: "data-viz",
  },
  {
    category: "Display",
    components: ["Card", "Badge", "Avatar", "Separator", "Skeleton", "Table"],
    icon: SquaresIcon,
    slug: "display",
  },
  {
    category: "Feedback",
    components: ["Alert", "Toast", "Progress", "Tooltip"],
    icon: BellIcon,
    slug: "feedback",
  },
  {
    category: "Inputs",
    components: ["Button", "Input", "Textarea", "Select", "Checkbox", "RadioGroup", "Switch"],
    icon: CursorIcon,
    slug: "inputs",
  },
  {
    category: "Navigation",
    components: ["Tabs", "Breadcrumb", "Pagination"],
    icon: CompassIcon,
    slug: "navigation",
  },
  {
    category: "Overlay",
    components: ["Modal", "Popover", "DropdownMenu", "Drawer"],
    icon: LayersIcon,
    slug: "overlay",
  },
];

function toSlug(name: string): string {
  return name
    .replace(/[A-Z]/g, (char, offset: number) => (offset > 0 ? `-${char}` : char))
    .toLowerCase();
}

export function Sidebar({ onNavigate }: SidebarProps) {
  const pathname = usePathname();
  const [activeAnchor, setActiveAnchor] = useState("");

  const activeSlug = pathname.startsWith("/library/")
    ? pathname.slice("/library/".length)
    : "";

  useEffect(() => {
    setActiveAnchor("");

    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    if (sections.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveAnchor(entry.target.id);
          }
        }
      },
      { rootMargin: "-80px 0px -66% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
    return () => observer.disconnect();
  }, [pathname]);

  return (
    <nav
      aria-label="Component library navigation"
      className="flex h-full flex-col"
    >
      <div className="flex h-14 shrink-0 items-center gap-2.5 border-b border-border px-4">
        <span className="text-primary">
          <LogoIcon />
        </span>
        <Link
          className="text-sm font-semibold text-foreground transition-colors hover:text-primary"
          href="/library"
          onClick={onNavigate}
        >
          Component Library
        </Link>
      </div>

      <div className="flex-1 overflow-y-auto py-3">
        {NAV_ITEMS.map(({ category, components, icon: Icon, slug }) => {
          const isCategoryActive = activeSlug === slug;

          return (
            <div className="px-2 py-0.5" key={slug}>
              <Link
                className={cn(
                  "flex cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 text-sm font-medium transition-colors hover:bg-accent hover:text-foreground",
                  isCategoryActive
                    ? "bg-primary/10 text-primary"
                    : "text-muted-foreground",
                )}
                href={`/library/${slug}`}
                onClick={onNavigate}
              >
                <Icon />
                <span className="flex-1">{category}</span>
                <span
                  className={cn(
                    "rounded-full px-1.5 py-0.5 text-[10px] font-medium tabular-nums",
                    isCategoryActive
                      ? "bg-primary/20 text-primary"
                      : "bg-muted text-muted-foreground",
                  )}
                >
                  {components.length}
                </span>
              </Link>

              <div className="ml-4 mt-0.5 space-y-0.5 border-l border-border pl-3">
                {components.map((component) => {
                  const componentSlug = toSlug(component);
                  const isAnchorActive =
                    isCategoryActive && activeAnchor === componentSlug;

                  return (
                    <Link
                      className={cn(
                        "block cursor-pointer rounded-md px-2 py-1 text-sm transition-colors hover:bg-accent/60 hover:text-foreground",
                        isAnchorActive
                          ? "bg-accent/80 font-medium text-foreground"
                          : "text-muted-foreground",
                      )}
                      href={`/library/${slug}#${componentSlug}`}
                      key={componentSlug}
                      onClick={onNavigate}
                    >
                      {component}
                    </Link>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>

      <div className="shrink-0 border-t border-border px-4 py-3">
        <p className="text-[11px] text-muted-foreground">
          {NAV_ITEMS.reduce((acc, { components }) => acc + components.length, 0)} components
        </p>
      </div>
    </nav>
  );
}
