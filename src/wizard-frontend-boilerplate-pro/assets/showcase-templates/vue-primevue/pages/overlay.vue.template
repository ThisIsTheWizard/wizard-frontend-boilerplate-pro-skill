<script setup lang="ts">
import { ref } from "vue";

import Button from "primevue/button";
import Drawer from "primevue/drawer";
import Menu from "primevue/menu";
import Popover from "primevue/popover";

import CodeBlock from "@/components/CodeBlock.vue";

const drawerVisible = ref(false);
const menuRef = ref<InstanceType<typeof Menu> | null>(null);
const popoverRef = ref<InstanceType<typeof Popover> | null>(null);

const MENU_ITEMS = [
  {
    items: [
      { command: () => {}, label: "Profile" },
      { command: () => {}, label: "Settings" },
      { command: () => {}, label: "Billing" },
    ],
    label: "My Account",
  },
];

function toggleMenu(event: Event) {
  menuRef.value?.toggle(event);
}

function togglePopover(event: Event) {
  popoverRef.value?.toggle(event);
}

const POPOVER_CODE = `<script setup lang="ts">
import { ref } from "vue";
import Button from "primevue/button";
import Popover from "primevue/popover";

const popoverRef = ref(null);

function toggle(event) {
  popoverRef.value?.toggle(event);
}
<\/script>

<template>
  <Button label="Open Popover" outlined severity="primary" @click="toggle" />
  <Popover ref="popoverRef">
    <div class="p-3">
      <p class="text-sm text-muted-foreground">This is a popover. It can contain any content.</p>
      <Button class="mt-3 w-full" label="Close" outlined severity="secondary" size="small" @click="popoverRef?.hide()" />
    </div>
  </Popover>
</template>`;

const DROPDOWN_CODE = `<script setup lang="ts">
import { ref } from "vue";
import Button from "primevue/button";
import Menu from "primevue/menu";

const menuRef = ref(null);

const items = [
  {
    label: "My Account",
    items: [
      { label: "Profile", command: () => {} },
      { label: "Settings", command: () => {} },
      { label: "Billing", command: () => {} },
    ],
  },
];

function toggle(event) {
  menuRef.value?.toggle(event);
}
<\/script>

<template>
  <Button label="Options" outlined severity="primary" @click="toggle" />
  <Menu ref="menuRef" :model="items" popup />
</template>`;

const SHEET_CODE = `<script setup lang="ts">
import { ref } from "vue";
import Button from "primevue/button";
import Drawer from "primevue/drawer";

const visible = ref(false);
<\/script>

<template>
  <Button label="Open Sheet" outlined severity="primary" @click="visible = true" />
  <Drawer v-model:visible="visible" header="Edit profile" position="right">
    <p class="text-sm text-muted-foreground">
      Make changes to your profile here. Click save when you're done.
    </p>
    <template #footer>
      <Button label="Close" outlined severity="secondary" @click="visible = false" />
      <Button label="Save" severity="primary" />
    </template>
  </Drawer>
</template>`;
</script>

<template>
  <div class="flex flex-col gap-16">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground">Overlay</h1>
      <p class="mt-2 text-muted-foreground">
        Floating UI components that render above the main content — popovers, dropdown menus, and
        sheets.
      </p>
    </div>

    <section class="flex flex-col gap-4" id="popover">
      <div class="border-l-2 border-primary/40 pl-3">
        <h2 class="text-xl font-semibold text-foreground">Popover</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          A non-modal floating panel via
          <code class="rounded bg-muted px-1 py-0.5 text-xs">Popover</code>. Get a ref and call
          <code class="rounded bg-muted px-1 py-0.5 text-xs">.toggle(event)</code> to open/close.
          Dismissed by clicking outside or pressing Escape.
        </p>
      </div>
      <div class="rounded-lg border border-border bg-muted/50 p-8">
        <Button label="Open Popover" outlined severity="primary" @click="togglePopover" />
        <Popover ref="popoverRef">
          <div class="p-3">
            <p class="text-sm text-muted-foreground">
              This is a popover. It can contain any content.
            </p>
            <Button
              class="mt-3 w-full"
              label="Close"
              outlined
              severity="secondary"
              size="small"
              @click="(popoverRef as InstanceType<typeof Popover>)?.hide()"
            />
          </div>
        </Popover>
      </div>
      <CodeBlock
        :code="POPOVER_CODE"
        :collapsible="true"
        :default-open="false"
        filename="Popover.vue"
        language="vue"
      />
    </section>

    <section class="flex flex-col gap-4" id="dropdown-menu">
      <div class="border-l-2 border-primary/40 pl-3">
        <h2 class="text-xl font-semibold text-foreground">DropdownMenu</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          A contextual popup menu via
          <code class="rounded bg-muted px-1 py-0.5 text-xs">Menu</code> with
          <code class="rounded bg-muted px-1 py-0.5 text-xs">popup</code> prop. Get a ref and call
          <code class="rounded bg-muted px-1 py-0.5 text-xs">.toggle(event)</code> to open/close.
        </p>
      </div>
      <div class="rounded-lg border border-border bg-muted/50 p-8">
        <Button label="Options" outlined severity="primary" @click="toggleMenu" />
        <Menu ref="menuRef" :model="MENU_ITEMS" popup />
      </div>
      <CodeBlock
        :code="DROPDOWN_CODE"
        :collapsible="true"
        :default-open="false"
        filename="DropdownMenu.vue"
        language="vue"
      />
    </section>

    <section class="flex flex-col gap-4" id="sheet">
      <div class="border-l-2 border-primary/40 pl-3">
        <h2 class="text-xl font-semibold text-foreground">Sheet</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          A slide-in panel from any screen edge via
          <code class="rounded bg-muted px-1 py-0.5 text-xs">Drawer</code>. Use
          <code class="rounded bg-muted px-1 py-0.5 text-xs">position</code> (left/right/top/bottom)
          and bind <code class="rounded bg-muted px-1 py-0.5 text-xs">v-model:visible</code>.
        </p>
      </div>
      <div class="rounded-lg border border-border bg-muted/50 p-8">
        <Button label="Open Sheet" outlined severity="primary" @click="drawerVisible = true" />
        <Drawer v-model:visible="drawerVisible" header="Edit profile" position="right">
          <p class="text-sm text-muted-foreground">
            Make changes to your profile here. Click save when you're done.
          </p>
          <template #footer>
            <Button
              label="Close"
              outlined
              severity="secondary"
              @click="drawerVisible = false"
            />
            <Button label="Save" severity="primary" @click="drawerVisible = false" />
          </template>
        </Drawer>
      </div>
      <CodeBlock
        :code="SHEET_CODE"
        :collapsible="true"
        :default-open="false"
        filename="Sheet.vue"
        language="vue"
      />
    </section>
  </div>
</template>
