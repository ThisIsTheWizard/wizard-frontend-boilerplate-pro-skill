const TOAST_CODE = `import { useState } from "react";

type ToastKind = "info" | "success" | "warning" | "error";

const MESSAGES: Record<ToastKind, string> = {
  error: "Something went wrong.",
  info: "Event has been created.",
  success: "Profile saved successfully.",
  warning: "Unsaved changes detected.",
};

export function Example() {
  const [toast, setToast] = useState<ToastKind | null>(null);

  const show = (kind: ToastKind) => {
    setToast(kind);
    setTimeout(() => setToast(null), 3000);
  };

  return (
    <>
      <div className="flex flex-wrap gap-2">
        <button className="btn btn-primary btn-sm" onClick={() => show("info")} type="button">Info</button>
        <button className="btn btn-success btn-sm" onClick={() => show("success")} type="button">Success</button>
        <button className="btn btn-error btn-sm" onClick={() => show("error")} type="button">Error</button>
        <button className="btn btn-warning btn-sm" onClick={() => show("warning")} type="button">Warning</button>
      </div>
      {toast && (
        <div className="toast toast-end toast-bottom z-50">
          <div className={\`alert alert-\${toast}\`} role="alert">
            <span className="text-sm">{MESSAGES[toast]}</span>
          </div>
        </div>
      )}
    </>
  );
}`;

