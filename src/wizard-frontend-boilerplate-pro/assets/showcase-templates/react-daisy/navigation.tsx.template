const TABS_CODE = `import { useState } from "react";

export function Example() {
  const [active, setActive] = useState("account");

  const tabs = [
    { id: "account", label: "Account" },
    { id: "password", label: "Password" },
    { id: "notifications", label: "Notifications" },
  ] as const;

  const content: Record<typeof tabs[number]["id"], string> = {
    account: "Manage your account settings and preferences.",
    notifications: "Configure how you receive notifications.",
    password: "Change your password and security settings.",
  };

  return (
    <div>
      <div className="tabs tabs-bordered" role="tablist">
        {tabs.map(({ id, label }) => (
          <button
            className={\`tab \${active === id ? "tab-active" : ""}\`}
            key={id}
            onClick={() => setActive(id)}
            role="tab"
            type="button"
          >
            {label}
          </button>
        ))}
      </div>
      <div className="pt-4">
        <p className="text-base-content/60 text-sm">{content[active]}</p>
      </div>
    </div>
  );
}`;

