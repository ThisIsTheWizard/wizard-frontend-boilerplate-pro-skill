  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="12" rx="1" width="4" x="3" y="9" />
      <rect height="18" rx="1" width="4" x="10" y="3" />
      <rect height="8" rx="1" width="4" x="17" y="13" />
    </svg>
  );
}

function SquaresIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="7" rx="1.5" width="7" x="3" y="3" />
      <rect height="7" rx="1.5" width="7" x="14" y="3" />
      <rect height="7" rx="1.5" width="7" x="3" y="14" />
      <rect height="7" rx="1.5" width="7" x="14" y="14" />
    </svg>
  );
}

function BellIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
      <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
    </svg>
  );
}

function CursorIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="m4 4 7.07 17 2.51-7.39L21 11.07z" />
    </svg>
  );
}

function CompassIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" />
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
    </svg>
  );
}

function LayersIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </svg>
  );
}

const NAV_ITEMS: NavItem[] = [
  {
    category: "Data viz",
    components: ["Chart", "DataTable", "Calendar"],
    icon: BarChartIcon,
    slug: "data-viz",
  },
  {
    category: "Display",
    components: ["Card", "Badge", "Avatar", "Separator", "Skeleton", "Table"],
    icon: SquaresIcon,
    slug: "display",
  },
  {
    category: "Feedback",
    components: ["Alert", "Toast", "Progress", "Tooltip", "Modal"],
    icon: BellIcon,
    slug: "feedback",
  },
  {
    category: "Inputs",
    components: ["Button", "Input", "Textarea", "Select", "Checkbox", "RadioGroup", "Toggle"],
    icon: CursorIcon,
    slug: "inputs",
  },
  {
    category: "Navigation",
    components: ["Tabs", "Breadcrumbs", "Pagination", "Navbar"],
    icon: CompassIcon,
    slug: "navigation",
  },
  {
    category: "Overlay",
    components: ["Tooltip", "Dropdown", "Drawer"],
    icon: LayersIcon,
    slug: "overlay",
  },
];

function toSlug(name: string): string {
  return name
    .replace(/[A-Z]/g, (char, offset: number) => (offset > 0 ? `-${char}` : char))
    .toLowerCase();
}

export function Sidebar({ onNavigate }: SidebarProps) {
  const pathname = usePathname();
  const [activeAnchor, setActiveAnchor] = useState("");

  const activeSlug = pathname.startsWith("/library/")
    ? pathname.slice("/library/".length)
    : "";

  useEffect(() => {
    setActiveAnchor("");

    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    if (sections.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveAnchor(entry.target.id);
          }
        }
      },
      { rootMargin: "-80px 0px -66% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
    return () => observer.disconnect();
  }, [pathname]);

  const totalComponents = NAV_ITEMS.reduce(
    (acc, { components }) => acc + components.length,
    0,
  );

  return (
    <div className="flex flex-col h-full">
      {/* Header */}
      <div
        className="flex items-center gap-2 px-3 border-b border-base-300 flex-shrink-0"
        style={{ height: 56 }}
      >
        <span className="text-primary">
          <LogoIcon />
        </span>
        <Link
          className="font-semibold text-sm text-base-content no-underline hover:text-primary transition-colors"
          href="/library"
          onClick={onNavigate}
        >
          Component Library
        </Link>
      </div>

      {/* Nav list */}
      <div className="flex-grow overflow-y-auto py-2">
        {NAV_ITEMS.map(({ category, components, icon: Icon, slug }) => {
          const isCategoryActive = activeSlug === slug;

          return (
            <div className="px-2 py-1" key={slug}>
              {/* Category link */}
              <Link
                className={[
                  "flex items-center gap-2 px-2 py-2 rounded-btn text-sm font-medium no-underline transition-colors",
                  isCategoryActive
                    ? "bg-primary text-primary-content"
                    : "text-base-content hover:bg-base-200",
                ].join(" ")}
                href={`/library/${slug}`}
                onClick={onNavigate}
              >
                <Icon />
                <span className="flex-grow">{category}</span>
                <span
                  className={[
                    "badge badge-sm",
                    isCategoryActive ? "badge-ghost" : "badge-ghost",
                  ].join(" ")}
                >
                  {components.length}
                </span>
              </Link>

              {/* Sub-items */}
              <ul
                className="list-none m-0 ms-3 mt-1 pl-3"
                style={{ borderLeft: "1px solid var(--color-base-300, oklch(var(--b3)))" }}
              >
                {components.map((component) => {
                  const componentSlug = toSlug(component);
                  const isAnchorActive =
                    isCategoryActive && activeAnchor === componentSlug;

                  return (
                    <li key={componentSlug}>
                      <Link
                        className={[
                          "block px-2 py-1 rounded text-sm no-underline transition-colors",
                          isAnchorActive
                            ? "font-semibold text-primary"
                            : "text-base-content/60 hover:text-base-content",
                        ].join(" ")}
                        href={`/library/${slug}#${componentSlug}`}
                        onClick={onNavigate}
                      >
                        {component}
                      </Link>
                    </li>
                  );
                })}
              </ul>
            </div>
          );
        })}
      </div>

      {/* Footer */}
      <div
        className="px-3 py-2 border-t border-base-300 flex-shrink-0"
      >
        <small className="text-base-content/50 text-xs">{totalComponents} components</small>
      </div>
    </div>
  );
}
