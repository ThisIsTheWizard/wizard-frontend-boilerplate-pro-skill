          <p className="text-base-content/60 text-sm mb-0">
            DaisyUI does not ship a chart component. Use{" "}
            <strong>recharts</strong> directly with{" "}
            <code className="kbd kbd-sm">ResponsiveContainer</code> for
            size-aware rendering. Reference{" "}
            <code className="kbd kbd-sm">var(--color-primary)</code> and{" "}
            <code className="kbd kbd-sm">var(--color-secondary)</code> for
            colours to stay in sync with the active DaisyUI theme.
          </p>
        </div>
        <div className="bg-base-200 rounded-box p-4 mb-3">
          <ResponsiveContainer height={256} width="100%">
            <LineChart data={CHART_DATA}>
              <CartesianGrid strokeDasharray="3 3" />
              <XAxis dataKey="month" />
              <YAxis />
              <Tooltip />
              <Line
                dataKey="desktop"
