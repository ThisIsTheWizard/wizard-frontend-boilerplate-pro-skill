const CHART_CODE = `import {
  CartesianGrid,
  Line,
  LineChart,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";

const DATA = [
  { desktop: 186, mobile: 80, month: "Jan" },
  { desktop: 305, mobile: 200, month: "Feb" },
  { desktop: 237, mobile: 120, month: "Mar" },
  { desktop: 73, mobile: 190, month: "Apr" },
  { desktop: 209, mobile: 130, month: "May" },
  { desktop: 214, mobile: 140, month: "Jun" },
];

// DaisyUI has no chart primitive — use recharts directly.
export function Example() {
  return (
    <ResponsiveContainer height={256} width="100%">
      <LineChart data={DATA}>
        <CartesianGrid strokeDasharray="3 3" />
        <XAxis dataKey="month" />
        <YAxis />
        <Tooltip />
        <Line dataKey="desktop" name="Desktop" stroke="var(--color-primary)" type="monotone" />
        <Line dataKey="mobile" name="Mobile" stroke="var(--color-secondary)" type="monotone" />
      </LineChart>
    </ResponsiveContainer>
  );
}`;

interface User {
  email: string;
  id: string;
  name: string;
  role: string;
}

const TABLE_DATA: User[] = [
  { email: "alice@example.com", id: "1", name: "Alice Johnson", role: "Admin" },
  { email: "bob@example.com", id: "2", name: "Bob Smith", role: "Editor" },
  { email: "carol@example.com", id: "3", name: "Carol White", role: "Viewer" },
  { email: "dan@example.com", id: "4", name: "Dan Lee", role: "Editor" },
  { email: "eve@example.com", id: "5", name: "Eve Martinez", role: "Viewer" },
];

const DATA_TABLE_CODE = `import { useState } from "react";

interface User { email: string; id: string; name: string; role: string; }
type SortDir = "asc" | "desc";
type SortKey = keyof Omit<User, "id">;

function sortData(data: User[], key: SortKey, dir: SortDir): User[] {
  return [...data].sort((a, b) => {
    const result = a[key].localeCompare(b[key]);
    return dir === "asc" ? result : -result;
  });
}

export function Example({ rows }: { rows: User[] }) {
  const [sortKey, setSortKey] = useState<SortKey>("name");
  const [sortDir, setSortDir] = useState<SortDir>("asc");

  const handleSort = (key: SortKey) => {
    if (sortKey === key) {
      setSortDir((d) => (d === "asc" ? "desc" : "asc"));
    } else {
      setSortKey(key);
      setSortDir("asc");
    }
  };

  const sorted = sortData(rows, sortKey, sortDir);
  const indicator = (key: SortKey) =>
    sortKey === key ? (sortDir === "asc" ? " ↑" : " ↓") : "";

  return (
    <div className="overflow-x-auto">
      <table className="table table-zebra">
        <thead>
          <tr>
            {(["name", "email", "role"] as SortKey[]).map((key) => (
              <th
                className="cursor-pointer select-none hover:text-primary"
                key={key}
                onClick={() => handleSort(key)}
              >
                {key.charAt(0).toUpperCase() + key.slice(1)}
                {indicator(key)}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {sorted.map((row) => (
            <tr key={row.id}>
              <td>{row.name}</td>
              <td>{row.email}</td>
              <td>{row.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}`;

const CALENDAR_CODE = `// DaisyUI has no built-in date picker — use react-day-picker:
//   npm install react-day-picker

import { useState } from "react";
import { DayPicker } from "react-day-picker";
import "react-day-picker/dist/style.css";

export function Example() {
  const [selected, setSelected] = useState<Date | undefined>();

  return (
    <DayPicker
      mode="single"
      onSelect={setSelected}
      selected={selected}
    />
  );
}`;

type SortDir = "asc" | "desc";
type SortKey = keyof Omit<User, "id">;

function sortData(data: User[], key: SortKey, dir: SortDir): User[] {
  return [...data].sort((a, b) => {
    const result = a[key].localeCompare(b[key]);
    return dir === "asc" ? result : -result;
  });
}

