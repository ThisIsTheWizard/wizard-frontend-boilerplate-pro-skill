export function Example() {
  const [value, setValue] = useState("free");

  return (
    <FormControl>
      <FormLabel>Plan</FormLabel>
      <RadioGroup onChange={(e) => setValue(e.target.value)} value={value}>
        <FormControlLabel control={<Radio />} label="Free" value="free" />
        <FormControlLabel control={<Radio />} label="Pro" value="pro" />
        <FormControlLabel control={<Radio />} label="Enterprise" value="enterprise" />
      </RadioGroup>
    </FormControl>
  );
}`;

