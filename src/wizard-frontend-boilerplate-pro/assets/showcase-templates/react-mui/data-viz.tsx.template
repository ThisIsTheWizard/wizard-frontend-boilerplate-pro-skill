const CALENDAR_CODE = `// Requires: npm install @mui/x-date-pickers date-fns
import { useState } from "react";
import { AdapterDateFns } from "@mui/x-date-pickers/AdapterDateFns";
import { DateCalendar } from "@mui/x-date-pickers/DateCalendar";
import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";

export function Example() {
  const [date, setDate] = useState<Date | null>(new Date());

  return (
    <LocalizationProvider dateAdapter={AdapterDateFns}>
      <DateCalendar onChange={setDate} value={date} />
    </LocalizationProvider>
  );
}`;

type SortDir = "asc" | "desc";
type SortKey = keyof Omit<User, "id">;

function sortData(data: User[], key: SortKey, dir: SortDir): User[] {
  return [...data].sort((a, b) => {
    const result = a[key].localeCompare(b[key]);
    return dir === "asc" ? result : -result;
  });
}

export default function DataVizPage() {
  const [sortKey, setSortKey] = useState<SortKey>("name");
  const [sortDir, setSortDir] = useState<SortDir>("asc");

  const handleSort = (key: SortKey) => {
    if (sortKey === key) {
      setSortDir((d) => (d === "asc" ? "desc" : "asc"));
    } else {
      setSortKey(key);
      setSortDir("asc");
    }
  };

  const sortedData = sortData(TABLE_DATA, sortKey, sortDir);

  return (
    <Box sx={{ display: "flex", flexDirection: "column", gap: 8 }}>
      <Box>
        <Typography gutterBottom variant="h4">
          Data viz
        </Typography>
        <Typography color="text.secondary" variant="body1">
          Charts, sortable tables, and date selection — using recharts, MUI
          Table, and MUI X Date Pickers.
        </Typography>
      </Box>

      <Box component="section" id="chart" sx={{ display: "flex", flexDirection: "column", gap: 2 }}>
        <Box sx={{ borderLeft: 3, borderColor: "primary.main", pl: 1.5 }}>
          <Typography gutterBottom variant="h6">Chart</Typography>
          <Typography color="text.secondary" variant="body2">
            MUI does not ship a chart component. Use{" "}
            <strong>recharts</strong> directly with{" "}
            <code>ResponsiveContainer</code> for size-aware rendering. Reference
            the skill's CSS variables for colours to stay in sync with the
            active theme.
          </Typography>
        </Box>
        <Box
          sx={{
            bgcolor: "background.default",
            border: 1,
            borderColor: "divider",
            borderRadius: 2,
            p: 4,
          }}
        >
          <ResponsiveContainer height={256} width="100%">
            <LineChart data={CHART_DATA}>
              <CartesianGrid strokeDasharray="3 3" />
              <XAxis dataKey="month" />
              <YAxis />
              <Tooltip />
              <Line
                dataKey="desktop"
                name="Desktop"
                stroke="var(--color-accent-500)"
                type="monotone"
              />
              <Line
                dataKey="mobile"
                name="Mobile"
                stroke="var(--color-accent-300)"
                type="monotone"
              />
            </LineChart>
          </ResponsiveContainer>
        </Box>
        <CodeBlock
          code={CHART_CODE}
          collapsible
          defaultOpen={false}
          filename="Chart.tsx"
          language="tsx"
        />
      </Box>

      <Box component="section" id="data-table" sx={{ display: "flex", flexDirection: "column", gap: 2 }}>
        <Box sx={{ borderLeft: 3, borderColor: "primary.main", pl: 1.5 }}>
          <Typography gutterBottom variant="h6">DataTable</Typography>
          <Typography color="text.secondary" variant="body2">
            A sortable table using MUI's <code>Table</code> +{" "}
            <code>TableSortLabel</code>. For a full-featured grid with
            pagination, filtering, and virtual scrolling, install{" "}
            <code>@mui/x-data-grid</code> and replace this with{" "}
            <code>{"<DataGrid rows={rows} columns={columns} />"}</code>.
          </Typography>
        </Box>
        <Box
          sx={{
            bgcolor: "background.default",
            border: 1,
            borderColor: "divider",
            borderRadius: 2,
            p: 4,
          }}
        >
          <TableContainer component={Paper} variant="outlined">
            <Table aria-label="Users sortable table">
              <TableHead>
                <TableRow>
                  {(["name", "email", "role"] as SortKey[]).map((key) => (
                    <TableCell key={key}>
                      <TableSortLabel
                        active={sortKey === key}
                        direction={sortKey === key ? sortDir : "asc"}
                        onClick={() => handleSort(key)}
                      >
                        {key.charAt(0).toUpperCase() + key.slice(1)}
                      </TableSortLabel>
                    </TableCell>
                  ))}
                </TableRow>
              </TableHead>
              <TableBody>
                {sortedData.map((row) => (
