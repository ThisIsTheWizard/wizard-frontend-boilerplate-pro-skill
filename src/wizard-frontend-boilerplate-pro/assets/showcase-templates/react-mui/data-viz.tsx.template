      <Box component="section" id="calendar" sx={{ display: "flex", flexDirection: "column", gap: 2 }}>
        <Box sx={{ borderLeft: 3, borderColor: "primary.main", pl: 1.5 }}>
          <Typography gutterBottom variant="h6">Calendar</Typography>
          <Typography color="text.secondary" variant="body2">
            Date selection using MUI X's <code>DateCalendar</code>. Requires
