"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";

import Box from "@mui/material/Box";
import Chip from "@mui/material/Chip";
import List from "@mui/material/List";
import ListItem from "@mui/material/ListItem";
import ListItemButton from "@mui/material/ListItemButton";
import ListItemIcon from "@mui/material/ListItemIcon";
import ListItemText from "@mui/material/ListItemText";
import Typography from "@mui/material/Typography";

interface NavItem {
  category: string;
  components: string[];
  icon: React.FC;
  slug: string;
}

interface SidebarProps {
  onNavigate?: () => void;
}

function LogoIcon() {
  return (
    <svg
      aria-hidden="true"
      fill="none"
      height="20"
      viewBox="0 0 20 20"
      width="20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect fill="currentColor" height="7" opacity="0.9" rx="1.5" width="7" x="2" y="2" />
      <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="11" y="2" />
      <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="2" y="11" />
      <rect fill="currentColor" height="7" opacity="0.3" rx="1.5" width="7" x="11" y="11" />
    </svg>
  );
}

function BarChartIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="12" rx="1" width="4" x="3" y="9" />
      <rect height="18" rx="1" width="4" x="10" y="3" />
      <rect height="8" rx="1" width="4" x="17" y="13" />
    </svg>
  );
}

function SquaresIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="7" rx="1.5" width="7" x="3" y="3" />
      <rect height="7" rx="1.5" width="7" x="14" y="3" />
      <rect height="7" rx="1.5" width="7" x="3" y="14" />
      <rect height="7" rx="1.5" width="7" x="14" y="14" />
    </svg>
  );
}

function BellIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
      <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
    </svg>
  );
}

function CursorIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="m4 4 7.07 17 2.51-7.39L21 11.07z" />
    </svg>
  );
}

function CompassIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" />
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
    </svg>
  );
}

function LayersIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </svg>
  );
}

const NAV_ITEMS: NavItem[] = [
  {
    category: "Data viz",
    components: ["Chart", "DataTable", "Calendar"],
    icon: BarChartIcon,
    slug: "data-viz",
  },
  {
    category: "Display",
    components: ["Card", "Chip", "Avatar", "Divider", "Skeleton", "Table"],
    icon: SquaresIcon,
    slug: "display",
  },
  {
    category: "Feedback",
    components: ["Alert", "Snackbar", "LinearProgress", "Tooltip", "Dialog"],
    icon: BellIcon,
    slug: "feedback",
  },
  {
    category: "Inputs",
    components: ["Button", "TextField", "Select", "Checkbox", "RadioGroup", "Switch"],
    icon: CursorIcon,
    slug: "inputs",
  },
  {
    category: "Navigation",
    components: ["Tabs", "Breadcrumbs", "Pagination", "AppBar"],
    icon: CompassIcon,
    slug: "navigation",
  },
  {
    category: "Overlay",
    components: ["Popover", "Menu", "Drawer"],
    icon: LayersIcon,
    slug: "overlay",
  },
];

function toSlug(name: string): string {
  return name
    .replace(/[A-Z]/g, (char, offset: number) => (offset > 0 ? `-${char}` : char))
    .toLowerCase();
}

export function Sidebar({ onNavigate }: SidebarProps) {
  const pathname = usePathname();
  const [activeAnchor, setActiveAnchor] = useState("");

  const activeSlug = pathname.startsWith("/library/")
    ? pathname.slice("/library/".length)
    : "";

  useEffect(() => {
    setActiveAnchor("");

    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    if (sections.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveAnchor(entry.target.id);
          }
        }
      },
      { rootMargin: "-80px 0px -66% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
    return () => observer.disconnect();
  }, [pathname]);

  return (
    <Box sx={{ display: "flex", flexDirection: "column", height: "100%" }}>
      <Box
        sx={{
          alignItems: "center",
          borderBottom: 1,
          borderColor: "divider",
          display: "flex",
          gap: 1.25,
          height: 56,
          px: 2,
          shrink: 0,
        }}
      >
        <Box sx={{ color: "primary.main" }}>
          <LogoIcon />
        </Box>
        <Typography
          component={Link}
          href="/library"
          onClick={onNavigate}
          sx={{
            color: "text.primary",
            fontWeight: 600,
            textDecoration: "none",
            "&:hover": { color: "primary.main" },
          }}
          variant="body2"
        >
          Component Library
        </Typography>
      </Box>

      <Box sx={{ flexGrow: 1, overflowY: "auto", py: 1 }}>
        {NAV_ITEMS.map(({ category, components, icon: Icon, slug }) => {
          const isCategoryActive = activeSlug === slug;

          return (
            <Box key={slug} sx={{ px: 1, py: 0.25 }}>
              <ListItemButton
                component={Link}
                href={`/library/${slug}`}
                onClick={onNavigate}
                selected={isCategoryActive}
                sx={{
                  borderRadius: 1,
                  gap: 1.25,
                  py: 0.75,
                  "&.Mui-selected": { bgcolor: "primary.main", color: "primary.contrastText" },
                  "&.Mui-selected:hover": { bgcolor: "primary.dark" },
                }}
              >
                <ListItemIcon sx={{ color: "inherit", minWidth: 0 }}>
                  <Icon />
                </ListItemIcon>
                <ListItemText
                  primary={category}
                  primaryTypographyProps={{ fontSize: 14, fontWeight: 500 }}
                  sx={{ flexGrow: 1, my: 0 }}
                />
                <Chip
                  label={components.length}
                  size="small"
                  sx={{
                    fontSize: 10,
                    height: 18,
                    "& .MuiChip-label": { px: 0.75 },
                  }}
                />
              </ListItemButton>

              <List dense disablePadding sx={{ borderLeft: 1, borderColor: "divider", ml: 2, mt: 0.5, pl: 1.5 }}>
                {components.map((component) => {
                  const componentSlug = toSlug(component);
                  const isAnchorActive =
                    isCategoryActive && activeAnchor === componentSlug;

                  return (
                    <ListItem disablePadding key={componentSlug}>
                      <ListItemButton
                        component={Link}
                        href={`/library/${slug}#${componentSlug}`}
                        onClick={onNavigate}
                        selected={isAnchorActive}
                        sx={{
                          borderRadius: 1,
                          py: 0.5,
                          "&.Mui-selected": { bgcolor: "action.selected", fontWeight: 600 },
                        }}
                      >
                        <ListItemText
                          primary={component}
                          primaryTypographyProps={{ fontSize: 13 }}
                          sx={{ my: 0 }}
                        />
                      </ListItemButton>
                    </ListItem>
                  );
                })}
              </List>
            </Box>
          );
        })}
      </Box>

      <Box sx={{ borderTop: 1, borderColor: "divider", px: 2, py: 1.5, shrink: 0 }}>
        <Typography color="text.secondary" variant="caption">
          {NAV_ITEMS.reduce((acc, { components }) => acc + components.length, 0)} components
        </Typography>
      </Box>
    </Box>
  );
}
