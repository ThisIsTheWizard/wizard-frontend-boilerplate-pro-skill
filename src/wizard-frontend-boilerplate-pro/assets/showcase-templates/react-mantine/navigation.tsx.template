import { useState } from "react";

import {
  Anchor,
  Box,
  Breadcrumbs,
  Button,
  Divider,
  Flex,
  Group,
  Pagination,
  Stack,
  Tabs,
  Text,
  Title,
} from "@mantine/core";

import { CodeBlock } from "@/components/ui/code-block";

const TABS_CODE = `import { Box, Tabs, Text } from "@mantine/core";

export function Example() {
  return (
    <Tabs color="brand" defaultValue="account">
      <Tabs.List>
        <Tabs.Tab value="account">Account</Tabs.Tab>
        <Tabs.Tab value="password">Password</Tabs.Tab>
        <Tabs.Tab value="notifications">Notifications</Tabs.Tab>
      </Tabs.List>
      <Box pt="md">
        <Tabs.Panel value="account">
          <Text c="dimmed" fz="sm">
            Manage your account settings and preferences.
          </Text>
        </Tabs.Panel>
        <Tabs.Panel value="password">
          <Text c="dimmed" fz="sm">
            Change your password and security settings.
          </Text>
        </Tabs.Panel>
        <Tabs.Panel value="notifications">
          <Text c="dimmed" fz="sm">
            Configure how you receive notifications.
          </Text>
        </Tabs.Panel>
      </Box>
    </Tabs>
  );
}`;

const BREADCRUMB_CODE = `import { Anchor, Breadcrumbs, Stack } from "@mantine/core";

export function Example() {
  return (
    <Stack gap="sm">
      <Breadcrumbs>
        <Anchor href="#" fz="sm">Home</Anchor>
        <Anchor href="#" fz="sm">Library</Anchor>
        <span>Components</span>
      </Breadcrumbs>
      <Breadcrumbs separator="›">
        <Anchor href="#" fz="sm">Dashboard</Anchor>
        <Anchor href="#" fz="sm">Settings</Anchor>
        <span>Profile</span>
      </Breadcrumbs>
    </Stack>
  );
}`;

const PAGINATION_CODE = `import { useState } from "react";
import { Group, Pagination } from "@mantine/core";

export function Example() {
  const [page, setPage] = useState(1);

  return (
    <Group justify="center">
      <Pagination
        color="brand"
        onChange={setPage}
        total={10}
        value={page}
      />
    </Group>
  );
}`;

export default function NavigationPage() {
  const [page, setPage] = useState(1);

  return (
    <Box display="flex" style={{ flexDirection: "column", gap: 64 }}>
      <Box>
        <Title mb="xs" order={1}>
          Navigation
        </Title>
        <Text c="dimmed">
          Components for moving users through content — tabs, breadcrumbs,
