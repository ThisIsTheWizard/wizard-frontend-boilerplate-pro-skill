        </Text>
      </Box>

      {/* Tabs */}
      <Box component="section" id="tabs" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
        <Box pl="sm" style={{ borderLeft: "3px solid var(--color-accent-500)" }}>
          <Title mb={4} order={3}>Tabs</Title>
          <Text c="dimmed" fz="sm">
            A segmented tab strip using <code>Tabs</code> +{" "}
            <code>Tabs.List</code> + <code>Tabs.Tab</code> +{" "}
            <code>Tabs.Panel</code>. Match the <code>value</code> on{" "}
            <code>Tabs.Tab</code> and <code>Tabs.Panel</code> for automatic
            panel switching. Set <code>color="brand"</code> for the active
