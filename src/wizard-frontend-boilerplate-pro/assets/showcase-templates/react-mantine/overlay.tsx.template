"use client";

import { useState } from "react";

import {
  Box,
  Button,
  Divider,
  Drawer,
  Flex,
  Menu,
  Popover,
  Stack,
  Text,
  Title,
} from "@mantine/core";

import { CodeBlock } from "@/components/ui/code-block";

const POPOVER_CODE = `import { Box, Button, Popover, Text } from "@mantine/core";

export function Example() {
  return (
    <Popover shadow="md" width={240} withArrow>
      <Popover.Target>
        <Button variant="outline">Open Popover</Button>
      </Popover.Target>
      <Popover.Dropdown>
        <Box>
          <Text fw={600} fz="sm" mb={4}>Popover title</Text>
          <Text c="dimmed" fz="sm">
            This is a popover with some helpful content.
          </Text>
        </Box>
      </Popover.Dropdown>
    </Popover>
  );
}`;

const MENU_CODE = `import { Button, Menu, Text } from "@mantine/core";

export function Example() {
  return (
    <Menu shadow="md" width={200}>
      <Menu.Target>
        <Button variant="outline">Account</Button>
      </Menu.Target>
      <Menu.Dropdown>
        <Menu.Label>My Account</Menu.Label>
        <Menu.Item>Profile</Menu.Item>
        <Menu.Item>Settings</Menu.Item>
        <Menu.Item>Billing</Menu.Item>
        <Menu.Divider />
        <Menu.Item color="red">Log out</Menu.Item>
      </Menu.Dropdown>
    </Menu>
  );
}`;

const DRAWER_CODE = `import { useState } from "react";
import { Button, Drawer, Flex, Text } from "@mantine/core";

export function Example() {
  const [open, setOpen] = useState(false);

  return (
    <>
      <Button onClick={() => setOpen(true)} variant="outline">
        Open drawer
      </Button>
      <Drawer
        onClose={() => setOpen(false)}
        opened={open}
        position="right"
        title="Panel title"
      >
        <Text c="dimmed" fz="sm">
          This is a right-anchored drawer — Mantine's equivalent of shadcn's
          Sheet component. Use it for filters, detail views, or settings panels.
        </Text>
        <Flex justify="flex-end" mt="xl">
          <Button onClick={() => setOpen(false)} variant="default">
            Close
          </Button>
        </Flex>
      </Drawer>
    </>
  );
}`;

export default function OverlayPage() {
  const [drawerOpen, setDrawerOpen] = useState(false);

  return (
    <Box display="flex" style={{ flexDirection: "column", gap: 64 }}>
      <Box>
        <Title mb="xs" order={1}>
          Overlay
        </Title>
        <Text c="dimmed">
          Floating UI layers — popovers, contextual menus, and side-panel
          drawers.
        </Text>
      </Box>

      {/* Popover */}
      <Box component="section" id="popover" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
        <Box pl="sm" style={{ borderLeft: "3px solid var(--color-accent-500)" }}>
          <Title mb={4} order={3}>Popover</Title>
          <Text c="dimmed" fz="sm">
            An anchored floating panel. Mantine's <code>Popover</code> is a
            compound component: <code>Popover.Target</code> wraps the trigger
            and <code>Popover.Dropdown</code> contains the content. Add{" "}
            <code>withArrow</code> for the pointer indicator.
          </Text>
        </Box>
        <Box p="xl" style={{ border: "1px solid var(--border)", borderRadius: 8 }}>
          <Popover shadow="md" width={240} withArrow>
            <Popover.Target>
              <Button variant="outline">Open Popover</Button>
            </Popover.Target>
            <Popover.Dropdown>
              <Box>
                <Text fw={600} fz="sm" mb={4}>Popover title</Text>
                <Text c="dimmed" fz="sm">
                  This is a popover with some helpful content.
                </Text>
              </Box>
            </Popover.Dropdown>
          </Popover>
        </Box>
        <CodeBlock
          code={POPOVER_CODE}
          collapsible
          defaultOpen={false}
          filename="Popover.tsx"
          language="tsx"
        />
      </Box>

      <Divider />

      {/* Menu */}
      <Box component="section" id="menu" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
        <Box pl="sm" style={{ borderLeft: "3px solid var(--color-accent-500)" }}>
          <Title mb={4} order={3}>Menu</Title>
          <Text c="dimmed" fz="sm">
            A contextual dropdown list. Compose{" "}
            <code>Menu.Target</code> + <code>Menu.Dropdown</code> +{" "}
            <code>Menu.Item</code>. Use <code>Menu.Label</code> for section
            headers and <code>Menu.Divider</code> for separators. Pass{" "}
            <code>color="red"</code> on destructive items.
          </Text>
        </Box>
        <Box p="xl" style={{ border: "1px solid var(--border)", borderRadius: 8 }}>
          <Menu shadow="md" width={200}>
            <Menu.Target>
              <Button variant="outline">Account</Button>
            </Menu.Target>
            <Menu.Dropdown>
              <Menu.Label>My Account</Menu.Label>
              <Menu.Item>Profile</Menu.Item>
              <Menu.Item>Settings</Menu.Item>
              <Menu.Item>Billing</Menu.Item>
              <Menu.Divider />
              <Menu.Item color="red">Log out</Menu.Item>
            </Menu.Dropdown>
          </Menu>
        </Box>
        <CodeBlock
          code={MENU_CODE}
          collapsible
          defaultOpen={false}
          filename="Menu.tsx"
          language="tsx"
        />
      </Box>

      <Divider />

      {/* Drawer */}
      <Box component="section" id="drawer" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
        <Box pl="sm" style={{ borderLeft: "3px solid var(--color-accent-500)" }}>
          <Title mb={4} order={3}>Drawer</Title>
          <Text c="dimmed" fz="sm">
            A side panel that slides in from an edge — Mantine's equivalent of
            shadcn's Sheet. Set <code>position="right"</code> for the common
            right-hand panel pattern. Pass <code>opened</code>,{" "}
            <code>onClose</code>, and <code>title</code> directly on{" "}
            <code>Drawer</code>. Content renders as children.
          </Text>
        </Box>
        <Box p="xl" style={{ border: "1px solid var(--border)", borderRadius: 8 }}>
          <Button onClick={() => setDrawerOpen(true)} variant="outline">
            Open drawer
          </Button>
        </Box>
        <Drawer
          onClose={() => setDrawerOpen(false)}
          opened={drawerOpen}
          position="right"
          title="Panel title"
        >
          <Text c="dimmed" fz="sm">
            This is a right-anchored drawer — Mantine's equivalent of shadcn's
            Sheet component. Use it for filters, detail views, or settings panels.
          </Text>
          <Flex justify="flex-end" mt="xl">
            <Button onClick={() => setDrawerOpen(false)} variant="default">
              Close
            </Button>
          </Flex>
        </Drawer>
        <CodeBlock
          code={DRAWER_CODE}
          collapsible
          defaultOpen={false}
          filename="Drawer.tsx"
          language="tsx"
        />
      </Box>
    </Box>
  );
}
