import { CodeBlock } from "@/components/ui/code-block";

const ALERT_CODE = `import { Alert, Stack } from "@mantine/core";

export function Example() {
  return (
    <Stack gap="sm">
      <Alert color="blue" title="Heads up" variant="light">
        You can add components to your app using the CLI.
      </Alert>
      <Alert color="green" title="Success" variant="light">
        Your profile has been saved successfully.
      </Alert>
      <Alert color="yellow" title="Warning" variant="light">
        Unsaved changes will be lost.
      </Alert>
      <Alert color="red" title="Error" variant="light">
        Something went wrong. Please try again.
      </Alert>
    </Stack>
  );
}`;

const TOAST_CODE = `// Requires: npm install @mantine/notifications
// 1. Mount <Notifications /> once in your root layout inside MantineProvider
// 2. Call notifications.show() from any component
import { Button } from "@mantine/core";
import { notifications } from "@mantine/notifications";

export function Example() {
  return (
    <Button
      color="brand"
      onClick={() =>
        notifications.show({
          color: "green",
          message: "Your changes have been saved.",
          title: "Success",
        })
      }
      variant="filled"
    >
      Show toast
    </Button>
  );
}`;

const PROGRESS_CODE = `import { Box, Progress, Stack, Text } from "@mantine/core";

export function Example() {
  return (
    <Stack gap="md" maw={480}>
      <Box>
        <Text c="dimmed" fz="sm" mb={4}>25%</Text>
        <Progress color="brand" radius="xl" value={25} />
      </Box>
      <Box>
        <Text c="dimmed" fz="sm" mb={4}>60%</Text>
        <Progress color="brand" radius="xl" value={60} />
      </Box>
      <Box>
        <Text c="dimmed" fz="sm" mb={4}>90%</Text>
        <Progress color="brand" radius="xl" value={90} />
      </Box>
    </Stack>
  );
}`;

const TOOLTIP_CODE = `import { Button, Flex, Tooltip } from "@mantine/core";

export function Example() {
  return (
    <Flex gap="sm" wrap="wrap">
      <Tooltip label="Tooltip on top" position="top">
        <Button variant="outline">Top</Button>
      </Tooltip>
      <Tooltip label="Tooltip on right" position="right">
        <Button variant="outline">Right</Button>
      </Tooltip>
      <Tooltip label="Tooltip on bottom" position="bottom">
        <Button variant="outline">Bottom</Button>
      </Tooltip>
      <Tooltip label="Tooltip on left" position="left">
        <Button variant="outline">Left</Button>
      </Tooltip>
    </Flex>
  );
}`;

const DIALOG_CODE = `import { useState } from "react";
import { Button, Modal, Text } from "@mantine/core";

export function Example() {
  const [open, setOpen] = useState(false);

  return (
    <>
      <Button color="brand" onClick={() => setOpen(true)} variant="filled">
        Open dialog
      </Button>
      <Modal
        centered
        onClose={() => setOpen(false)}
        opened={open}
        title="Confirm action"
      >
        <Text fz="sm">
          This action cannot be undone. Are you sure you want to proceed?
        </Text>
        <Flex gap="sm" justify="flex-end" mt="lg">
          <Button onClick={() => setOpen(false)} variant="default">
            Cancel
          </Button>
          <Button color="brand" onClick={() => setOpen(false)} variant="filled">
            Confirm
          </Button>
        </Flex>
      </Modal>
    </>
  );
}`;

