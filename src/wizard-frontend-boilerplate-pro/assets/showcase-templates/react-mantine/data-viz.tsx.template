          language="tsx"
        />
      </Box>

      <Divider />

      {/* Calendar */}
      <Box component="section" id="calendar" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
        <Box pl="sm" style={{ borderLeft: "3px solid var(--color-accent-500)" }}>
          <Title mb={4} order={3}>Calendar</Title>
          <Text c="dimmed" fz="sm">
            Date selection using <code>react-day-picker</code>. Mantine core has
            no built-in calendar — this is the recommended lightweight approach.
