  return (
    <Box display="flex" style={{ flexDirection: "column", gap: 64 }}>
      <Box>
        <Title mb="xs" order={1}>
          Data viz
        </Title>
        <Text c="dimmed">
          Charts, sortable tables, and date selection — using recharts, Mantine
          Table with TanStack Table, and react-day-picker.
        </Text>
      </Box>

      {/* Chart */}
      <Box component="section" id="chart" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
        <Box pl="sm" style={{ borderLeft: "3px solid var(--color-accent-500)" }}>
          <Title mb={4} order={3}>Chart</Title>
          <Text c="dimmed" fz="sm">
            Mantine does not ship a chart component in its core package. Use{" "}
            <strong>recharts</strong> directly with{" "}
            <code>ResponsiveContainer</code> for size-aware rendering. Reference
            the skill's CSS variables for colours to stay in sync with the
            active theme.
          </Text>
        </Box>
        <Box p="xl" style={{ border: "1px solid var(--border)", borderRadius: 8 }}>
          <ResponsiveContainer height={256} width="100%">
            <LineChart data={CHART_DATA}>
              <CartesianGrid strokeDasharray="3 3" />
              <XAxis dataKey="month" />
              <YAxis />
              <Tooltip />
              <Line
                dataKey="desktop"
                name="Desktop"
                stroke="var(--color-accent-500)"
                type="monotone"
              />
              <Line
                dataKey="mobile"
                name="Mobile"
                stroke="var(--color-accent-300)"
                type="monotone"
              />
            </LineChart>
          </ResponsiveContainer>
        </Box>
        <CodeBlock
          code={CHART_CODE}
          collapsible
          defaultOpen={false}
          filename="Chart.tsx"
          language="tsx"
        />
      </Box>

      <Divider />

      {/* DataTable */}
      <Box component="section" id="data-table" style={{ display: "flex", flexDirection: "column", gap: 16 }}>
        <Box pl="sm" style={{ borderLeft: "3px solid var(--color-accent-500)" }}>
          <Title mb={4} order={3}>DataTable</Title>
          <Text c="dimmed" fz="sm">
            A sortable table using Mantine's <code>Table</code> components and{" "}
            <code>@tanstack/react-table</code> for headless sorting logic. Click
            a column header to toggle sort direction. Install with:{" "}
            <code>npm install @tanstack/react-table</code>
          </Text>
        </Box>
        <Box p="xl" style={{ border: "1px solid var(--border)", borderRadius: 8 }}>
          <Table highlightOnHover withColumnBorders withTableBorder>
            <Table.Thead>
              {table.getHeaderGroups().map((hg) => (
                <Table.Tr key={hg.id}>
                  {hg.headers.map((header) => (
                    <Table.Th
                      key={header.id}
                      onClick={header.column.getToggleSortingHandler()}
                      style={{ cursor: "pointer", userSelect: "none" }}
                    >
                      {flexRender(
                        header.column.columnDef.header,
                        header.getContext(),
                      )}
                      {header.column.getIsSorted() === "asc"
                        ? " ↑"
                        : header.column.getIsSorted() === "desc"
