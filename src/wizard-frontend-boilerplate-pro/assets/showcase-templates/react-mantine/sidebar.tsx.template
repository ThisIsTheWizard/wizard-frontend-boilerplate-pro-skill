function LayersIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </svg>
  );
}

const NAV_ITEMS: NavItem[] = [
  {
    category: "Data viz",
    components: ["Chart", "DataTable", "Calendar"],
    icon: BarChartIcon,
    slug: "data-viz",
  },
  {
    category: "Display",
    components: ["Card", "Badge", "Avatar", "Separator", "Skeleton", "Table"],
    icon: SquaresIcon,
    slug: "display",
  },
  {
    category: "Feedback",
    components: ["Alert", "Toast", "Progress", "Tooltip", "Dialog"],
    icon: BellIcon,
    slug: "feedback",
  },
  {
    category: "Inputs",
    components: ["Button", "Input", "Textarea", "Select", "Checkbox", "RadioGroup", "Switch"],
    icon: CursorIcon,
    slug: "inputs",
  },
  {
    category: "Navigation",
    components: ["Tabs", "Breadcrumb", "Pagination"],
    icon: CompassIcon,
    slug: "navigation",
  },
  {
    category: "Overlay",
    components: ["Popover", "Menu", "Drawer"],
    icon: LayersIcon,
    slug: "overlay",
  },
];

function toSlug(name: string): string {
  return name
    .replace(/[A-Z]/g, (char, offset: number) => (offset > 0 ? `-${char}` : char))
    .toLowerCase();
}

export function Sidebar({ onNavigate }: SidebarProps) {
  const pathname = usePathname();
  const [activeAnchor, setActiveAnchor] = useState("");

  const activeSlug = pathname.startsWith("/library/")
    ? pathname.slice("/library/".length)
    : "";

  useEffect(() => {
    setActiveAnchor("");

    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    if (sections.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveAnchor(entry.target.id);
          }
        }
      },
      { rootMargin: "-80px 0px -66% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
    return () => observer.disconnect();
  }, [pathname]);

  const totalComponents = NAV_ITEMS.reduce(
    (acc, { components }) => acc + components.length,
    0,
  );

  return (
    <Flex direction="column" h="100%">
      {/* Logo header */}
      <Flex
        align="center"
        gap="sm"
        h={56}
        px="md"
        style={{
          borderBottom: "1px solid var(--border)",
          flexShrink: 0,
        }}
      >
        <Box c="var(--color-accent-500)">
          <LogoIcon />
        </Box>
        <Text
          c="var(--foreground)"
          component={Link}
          fw={600}
          fz="sm"
          href="/library"
          onClick={onNavigate}
          style={{ textDecoration: "none" }}
        >
          Component Library
        </Text>
      </Flex>

      {/* Navigation */}
      <ScrollArea flex={1} py="xs">
        <Box px="xs">
          {NAV_ITEMS.map(({ category, components, icon: Icon, slug }) => {
            const isCategoryActive = activeSlug === slug;

            return (
              <Box key={slug} mb={4}>
                <NavLink
                  active={isCategoryActive}
                  color="brand"
                  component={Link}
                  href={`/library/${slug}`}
                  label={category}
                  leftSection={<Icon />}
                  onClick={onNavigate}
                  rightSection={
                    <Badge
                      circle
                      color={isCategoryActive ? "white" : "gray"}
                      size="sm"
                      style={isCategoryActive ? { color: "var(--color-accent-500)" } : undefined}
                      variant="light"
                    >
                      {components.length}
                    </Badge>
                  }
                  styles={{
                    label: { fontSize: 13, fontWeight: 500 },
                    root: { borderRadius: 6 },
                  }}
                />

                {/* Component anchors */}
                <Box
                  ml={28}
                  pl="xs"
                  style={{
                    borderLeft: "1px solid var(--border)",
                    marginTop: 2,
                  }}
                >
                  {components.map((component) => {
                    const componentSlug = toSlug(component);
                    const isAnchorActive =
                      isCategoryActive && activeAnchor === componentSlug;

                    return (
                      <Text
                        c={isAnchorActive ? "var(--color-accent-500)" : "dimmed"}
                        component={Link}
                        display="block"
                        fw={isAnchorActive ? 600 : 400}
                        fz={13}
                        href={`/library/${slug}#${componentSlug}`}
                        key={componentSlug}
                        onClick={onNavigate}
                        px={8}
                        py={4}
                        style={{
                          borderRadius: 4,
                          textDecoration: "none",
                          transition: "color 0.15s",
                        }}
                      >
                        {component}
                      </Text>
                    );
                  })}
                </Box>
              </Box>
            );
          })}
        </Box>
      </ScrollArea>

      {/* Footer */}
      <Box
        px="md"
        py="sm"
        style={{
          borderTop: "1px solid var(--border)",
          flexShrink: 0,
        }}
      >
        <Text c="dimmed" fz="xs">
          {totalComponents} components
        </Text>
      </Box>
    </Flex>
  );
}
