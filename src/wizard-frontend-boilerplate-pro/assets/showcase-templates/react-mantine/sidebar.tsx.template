"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";

import { Badge, Box, Flex, NavLink, ScrollArea, Text } from "@mantine/core";

interface NavItem {
  category: string;
  components: string[];
  icon: React.FC;
  slug: string;
}

interface SidebarProps {
  onNavigate?: () => void;
}

