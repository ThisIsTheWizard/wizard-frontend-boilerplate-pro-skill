"use client";

import { useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";

import { Flex, Menu, Typography } from "antd";
import type { MenuProps } from "antd";

interface NavItem {
  category: string;
  components: string[];
  icon: React.FC;
  slug: string;
}

interface SidebarProps {
  onNavigate?: () => void;
}

function LogoIcon() {
  return (
    <svg
      aria-hidden="true"
      fill="none"
      height="20"
      viewBox="0 0 20 20"
      width="20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect fill="currentColor" height="7" opacity="0.9" rx="1.5" width="7" x="2" y="2" />
      <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="11" y="2" />
      <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="2" y="11" />
      <rect fill="currentColor" height="7" opacity="0.3" rx="1.5" width="7" x="11" y="11" />
    </svg>
  );
}

function BarChartIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="12" rx="1" width="4" x="3" y="9" />
      <rect height="18" rx="1" width="4" x="10" y="3" />
      <rect height="8" rx="1" width="4" x="17" y="13" />
    </svg>
  );
}

function SquaresIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="7" rx="1.5" width="7" x="3" y="3" />
      <rect height="7" rx="1.5" width="7" x="14" y="3" />
      <rect height="7" rx="1.5" width="7" x="3" y="14" />
      <rect height="7" rx="1.5" width="7" x="14" y="14" />
    </svg>
  );
}

function BellIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
      <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
    </svg>
  );
}

function CursorIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="m4 4 7.07 17 2.51-7.39L21 11.07z" />
    </svg>
  );
}

function CompassIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" />
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
    </svg>
  );
}

function LayersIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </svg>
  );
}

const NAV_ITEMS: NavItem[] = [
  {
    category: "Data viz",
    components: ["Chart", "DataTable", "Calendar"],
    icon: BarChartIcon,
    slug: "data-viz",
  },
  {
    category: "Display",
    components: ["Card", "Badge", "Avatar", "Separator", "Skeleton", "Table"],
    icon: SquaresIcon,
    slug: "display",
  },
  {
    category: "Feedback",
    components: ["Alert", "Toast", "Progress", "Tooltip", "Dialog"],
    icon: BellIcon,
    slug: "feedback",
  },
  {
    category: "Inputs",
    components: ["Button", "Input", "Textarea", "Select", "Checkbox", "RadioGroup", "Switch"],
    icon: CursorIcon,
    slug: "inputs",
  },
  {
    category: "Navigation",
    components: ["Tabs", "Breadcrumb", "Pagination"],
    icon: CompassIcon,
    slug: "navigation",
  },
  {
    category: "Overlay",
    components: ["Popover", "Menu", "Drawer"],
    icon: LayersIcon,
    slug: "overlay",
  },
];

function toSlug(name: string): string {
  return name
    .replace(/[A-Z]/g, (char, offset: number) => (offset > 0 ? `-${char}` : char))
    .toLowerCase();
}

const ALL_OPEN_KEYS = NAV_ITEMS.map(({ slug }) => slug);

const totalComponents = NAV_ITEMS.reduce(
  (acc, { components }) => acc + components.length,
  0,
);

export function Sidebar({ onNavigate }: SidebarProps) {
  const pathname = usePathname();
  const [openKeys, setOpenKeys] = useState<string[]>(ALL_OPEN_KEYS);

  const activeSlug = pathname.startsWith("/library/")
    ? pathname.slice("/library/".length).split("#")[0]
    : "";

  const menuItems: MenuProps["items"] = NAV_ITEMS.map(
    ({ category, components, icon: Icon, slug }) => ({
      children: components.map((component) => {
        const componentSlug = toSlug(component);
        return {
          key: `${slug}#${componentSlug}`,
          label: (
            <Link
              href={`/library/${slug}#${componentSlug}`}
              onClick={onNavigate}
              style={{ display: "block", fontSize: 13 }}
            >
              {component}
            </Link>
          ),
        };
      }),
      icon: <Icon />,
      key: slug,
      label: (
        <Link
          href={`/library/${slug}`}
          onClick={onNavigate}
          style={{ fontSize: 13, fontWeight: 500 }}
        >
          {category}
        </Link>
      ),
    }),
  );

  return (
    <Flex direction="column" style={{ height: "100%" }}>
      {/* Logo header */}
      <Flex
        align="center"
        gap={8}
        style={{
          borderBottom: "1px solid var(--border)",
          flexShrink: 0,
          height: 56,
          padding: "0 16px",
        }}
      >
        <span style={{ color: "var(--color-accent-500)", display: "flex" }}>
          <LogoIcon />
        </span>
        <Typography.Text
          strong
          style={{ color: "var(--foreground)", fontSize: 14 }}
        >
          <Link
            href="/library"
            onClick={onNavigate}
            style={{ color: "inherit", textDecoration: "none" }}
          >
            Component Library
          </Link>
        </Typography.Text>
      </Flex>

      {/* Navigation menu */}
      <div style={{ flex: 1, overflowY: "auto" }}>
        <Menu
          items={menuItems}
          mode="inline"
          onOpenChange={(keys) => setOpenKeys(keys as string[])}
          openKeys={openKeys}
          selectedKeys={activeSlug ? [activeSlug] : []}
          style={{ background: "transparent", border: "none" }}
        />
      </div>

      {/* Footer */}
      <Flex
        style={{
          borderTop: "1px solid var(--border)",
          flexShrink: 0,
          padding: "12px 16px",
        }}
      >
        <Typography.Text style={{ fontSize: 12 }} type="secondary">
          {totalComponents} components
        </Typography.Text>
      </Flex>
    </Flex>
  );
}
