"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";

import Badge from "react-bootstrap/Badge";

interface NavItem {
  category: string;
  components: string[];
  icon: React.FC;
  slug: string;
}

interface SidebarProps {
  onNavigate?: () => void;
}

function LogoIcon() {
  return (
    <svg
      aria-hidden="true"
      fill="none"
      height="20"
      viewBox="0 0 20 20"
      width="20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect fill="currentColor" height="7" opacity="0.9" rx="1.5" width="7" x="2" y="2" />
      <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="11" y="2" />
      <rect fill="currentColor" height="7" opacity="0.6" rx="1.5" width="7" x="2" y="11" />
      <rect fill="currentColor" height="7" opacity="0.3" rx="1.5" width="7" x="11" y="11" />
    </svg>
  );
}

function BarChartIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="12" rx="1" width="4" x="3" y="9" />
      <rect height="18" rx="1" width="4" x="10" y="3" />
      <rect height="8" rx="1" width="4" x="17" y="13" />
    </svg>
  );
}

function SquaresIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <rect height="7" rx="1.5" width="7" x="3" y="3" />
      <rect height="7" rx="1.5" width="7" x="14" y="3" />
      <rect height="7" rx="1.5" width="7" x="3" y="14" />
      <rect height="7" rx="1.5" width="7" x="14" y="14" />
    </svg>
  );
}

function BellIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
      <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
    </svg>
  );
}

function CursorIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <path d="m4 4 7.07 17 2.51-7.39L21 11.07z" />
    </svg>
  );
}

function CompassIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" />
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
    </svg>
  );
}

function LayersIcon() {
  return (
    <svg aria-hidden="true" fill="none" height="16" stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </svg>
  );
}

const NAV_ITEMS: NavItem[] = [
  {
    category: "Data viz",
    components: ["Chart", "DataTable", "Calendar"],
    icon: BarChartIcon,
    slug: "data-viz",
  },
  {
    category: "Display",
    components: ["Card", "Badge", "Avatar", "Separator", "Placeholder", "Table"],
    icon: SquaresIcon,
    slug: "display",
  },
  {
    category: "Feedback",
    components: ["Alert", "Toast", "ProgressBar", "Tooltip", "Modal"],
    icon: BellIcon,
    slug: "feedback",
  },
  {
    category: "Inputs",
    components: ["Button", "FormControl", "Textarea", "FormSelect", "Checkbox", "RadioGroup", "Switch"],
    icon: CursorIcon,
    slug: "inputs",
  },
  {
    category: "Navigation",
    components: ["Tabs", "Breadcrumb", "Pagination", "Navbar"],
    icon: CompassIcon,
    slug: "navigation",
  },
  {
    category: "Overlay",
    components: ["Popover", "Dropdown", "Offcanvas"],
    icon: LayersIcon,
    slug: "overlay",
  },
];

function toSlug(name: string): string {
  return name
    .replace(/[A-Z]/g, (char, offset: number) => (offset > 0 ? `-${char}` : char))
    .toLowerCase();
}

export function Sidebar({ onNavigate }: SidebarProps) {
  const pathname = usePathname();
  const [activeAnchor, setActiveAnchor] = useState("");

  const activeSlug = pathname.startsWith("/library/")
    ? pathname.slice("/library/".length)
    : "";

  useEffect(() => {
    setActiveAnchor("");

    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    if (sections.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveAnchor(entry.target.id);
          }
        }
      },
      { rootMargin: "-80px 0px -66% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
    return () => observer.disconnect();
  }, [pathname]);

  const totalComponents = NAV_ITEMS.reduce(
    (acc, { components }) => acc + components.length,
    0,
  );

  return (
    <div className="d-flex flex-column h-100">
      {/* Header */}
      <div
        className="d-flex align-items-center gap-2 px-3"
        style={{
          borderBottom: "1px solid var(--bs-border-color)",
          height: 56,
          flexShrink: 0,
        }}
      >
        <span style={{ color: "var(--bs-primary)" }}>
          <LogoIcon />
        </span>
        <Link
          className="fw-semibold small text-decoration-none text-body"
          href="/library"
          onClick={onNavigate}
          style={{ transition: "color 0.15s" }}
        >
          Component Library
        </Link>
      </div>

      {/* Nav list */}
      <div className="flex-grow-1 overflow-y-auto py-2">
        {NAV_ITEMS.map(({ category, components, icon: Icon, slug }) => {
          const isCategoryActive = activeSlug === slug;

          return (
            <div className="px-2 py-1" key={slug}>
              {/* Category link */}
              <Link
                className={[
                  "d-flex align-items-center gap-2 px-2 py-2 rounded text-decoration-none small fw-medium",
                  isCategoryActive
                    ? "bg-primary text-white"
                    : "text-body link-body-emphasis",
                ].join(" ")}
                href={`/library/${slug}`}
                onClick={onNavigate}
                style={{ transition: "background 0.15s" }}
              >
                <Icon />
                <span className="flex-grow-1">{category}</span>
                <Badge bg={isCategoryActive ? "light" : "secondary"} pill style={isCategoryActive ? { color: "var(--bs-primary)" } : undefined}>
                  {components.length}
                </Badge>
              </Link>

              {/* Sub-items */}
              <ul
                className="list-unstyled mb-0 ms-3 mt-1"
                style={{ borderLeft: "1px solid var(--bs-border-color)", paddingLeft: "0.75rem" }}
              >
                {components.map((component) => {
                  const componentSlug = toSlug(component);
                  const isAnchorActive =
                    isCategoryActive && activeAnchor === componentSlug;

                  return (
                    <li key={componentSlug}>
                      <Link
                        className={[
                          "d-block px-2 py-1 rounded text-decoration-none",
                          "small",
                          isAnchorActive
                            ? "fw-semibold text-primary bg-primary bg-opacity-10"
                            : "text-body-secondary",
                        ].join(" ")}
                        href={`/library/${slug}#${componentSlug}`}
                        onClick={onNavigate}
                      >
                        {component}
                      </Link>
                    </li>
                  );
                })}
              </ul>
            </div>
          );
        })}
      </div>

      {/* Footer */}
      <div
        className="px-3 py-2"
        style={{
          borderTop: "1px solid var(--bs-border-color)",
          flexShrink: 0,
        }}
      >
        <small className="text-body-secondary">{totalComponents} components</small>
      </div>
    </div>
  );
}
