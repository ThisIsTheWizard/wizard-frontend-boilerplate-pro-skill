              </SheetFooter>
            </SheetContent>
          </Sheet>
        </div>
        <CodeBlock
          code={SHEET_CODE}
          collapsible
          defaultOpen={false}
          filename="Sheet.tsx"
          language="tsx"
        />
      </section>
