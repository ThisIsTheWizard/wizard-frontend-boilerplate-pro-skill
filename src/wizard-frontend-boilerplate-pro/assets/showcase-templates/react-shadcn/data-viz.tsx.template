          </p>
        </div>
        <div className="rounded-lg border border-border bg-muted/50 p-8">
          <ChartContainer className="h-64 w-full" config={chartConfig}>
            <LineChart data={CHART_DATA}>
              <CartesianGrid strokeDasharray="3 3" />
              <XAxis dataKey="month" />
              <YAxis />
              <ChartTooltip content={<ChartTooltipContent />} />
              <ChartLegend content={<ChartLegendContent />} />
              <Line
                dataKey="desktop"
                stroke="var(--color-desktop)"
                type="monotone"
              />
              <Line
                dataKey="mobile"
                stroke="var(--color-mobile)"
                type="monotone"
              />
            </LineChart>
          </ChartContainer>
        </div>
        <CodeBlock
          code={CHART_CODE}
          collapsible
          defaultOpen={false}
          filename="Chart.tsx"
          language="tsx"
        />
      </section>

      <section className="flex flex-col gap-4" id="data-table">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">DataTable</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            A fully-featured table with sorting, filtering, and pagination
