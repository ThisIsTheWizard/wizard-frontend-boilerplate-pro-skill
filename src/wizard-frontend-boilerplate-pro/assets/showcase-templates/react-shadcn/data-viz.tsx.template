        <p className="mt-2 text-muted-foreground">
          Charts, interactive tables, and date pickers — built on recharts,
          TanStack Table, and date-fns.
        </p>
      </div>

      <section className="flex flex-col gap-4" id="chart">
        <div className="border-l-2 border-primary/40 pl-3">
          <h2 className="text-xl font-semibold text-foreground">Chart</h2>
          <p className="mt-1 text-sm text-muted-foreground">
            A responsive line chart with tooltip, legend, and semantic colour
