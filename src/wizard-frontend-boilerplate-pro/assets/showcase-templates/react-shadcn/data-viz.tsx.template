            <p className="text-sm text-muted-foreground">
              {selectedDate
                ? selectedDate.toLocaleDateString()
                : "No date selected"}
            </p>
          </div>
        </div>
        <CodeBlock
          code={CALENDAR_CODE}
          collapsible
          defaultOpen={false}
          filename="Calendar.tsx"
          language="tsx"
        />
      </section>
    </div>
