const DATA_TABLE_CODE = `<script setup lang="ts">
import { computed, ref } from "vue";
import { cn } from "@/lib/utils";

const rows = [
  { name: "Alice Martin", status: "Active", revenue: "$12,400", change: "+8%" },
  { name: "Bob Chen",     status: "Active", revenue: "$9,800",  change: "+3%" },
  { name: "Carol White",  status: "Paused", revenue: "$6,200",  change: "-2%" },
];

const sortAsc = ref(true);
const sorted = computed(() =>
  [...rows].sort((a, b) => sortAsc.value ? a.name.localeCompare(b.name) : b.name.localeCompare(a.name))
);
<\/script>

<template>
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-border bg-muted/50">
