  </table>
</template>`;

const CALENDAR_CODE = `<script setup lang="ts">
import { computed, ref } from "vue";
import { cn } from "@/lib/utils";

const today = new Date();
const current = ref({ year: today.getFullYear(), month: today.getMonth() });

const days = computed(() => {
  const first = new Date(current.value.year, current.value.month, 1);
  const last = new Date(current.value.year, current.value.month + 1, 0);
  const blanks = Array.from({ length: first.getDay() }, (_, i) => ({ day: 0, key: \`b-\${i}\` }));
  const filled = Array.from({ length: last.getDate() }, (_, i) => ({ day: i + 1, key: \`d-\${i + 1}\` }));
  return [...blanks, ...filled];
});

function prevMonth() {
  current.value = current.value.month === 0
    ? { year: current.value.year - 1, month: 11 }
    : { ...current.value, month: current.value.month - 1 };
}
function nextMonth() {
  current.value = current.value.month === 11
    ? { year: current.value.year + 1, month: 0 }
    : { ...current.value, month: current.value.month + 1 };
}
<\/script>

<template>
  <div class="w-72 rounded-xl border border-border bg-surface p-4">
    <div class="mb-3 flex items-center justify-between">
      <button @click="prevMonth" class="rounded p-1 hover:bg-accent">◂</button>
      <span class="text-sm font-semibold text-foreground">{{ new Date(current.year, current.month).toLocaleString("default", { month: "long", year: "numeric" }) }}</span>
      <button @click="nextMonth" class="rounded p-1 hover:bg-accent">▸</button>
    </div>
    <div class="grid grid-cols-7 gap-1 text-center text-xs text-muted-foreground">
      <div v-for="d in ['Su','Mo','Tu','We','Th','Fr','Sa']" :key="d">{{ d }}</div>
      <button v-for="{ day, key } in days" :key="key" :disabled="!day" :class="cn('rounded py-1 text-sm', !day && 'invisible', day === today.getDate() && current.month === today.getMonth() && current.year === today.getFullYear() ? 'bg-primary font-semibold text-primary-foreground' : 'text-foreground hover:bg-accent')">{{ day || "" }}</button>
    </div>
  </div>
</template>`;

const today = new Date();
const current = ref({ year: today.getFullYear(), month: today.getMonth() });
const sortAsc = ref(true);

const TABLE_ROWS = [
  { name: "Alice Martin", status: "Active", revenue: "$12,400", change: "+8%" },
  { name: "Bob Chen", status: "Active", revenue: "$9,800", change: "+3%" },
  { name: "Carol White", status: "Paused", revenue: "$6,200", change: "-2%" },
  { name: "Dan Kim", status: "Active", revenue: "$15,100", change: "+14%" },
  { name: "Eve Torres", status: "Paused", revenue: "$4,300", change: "-6%" },
];

const sorted = computed(() =>
  [...TABLE_ROWS].sort((a, b) =>
    sortAsc.value ? a.name.localeCompare(b.name) : b.name.localeCompare(a.name),
  ),
);

const days = computed(() => {
  const first = new Date(current.value.year, current.value.month, 1);
  const last = new Date(current.value.year, current.value.month + 1, 0);
  const blanks = Array.from({ length: first.getDay() }, (_, i) => ({ day: 0, key: `b-${i}` }));
  const filled = Array.from({ length: last.getDate() }, (_, i) => ({ day: i + 1, key: `d-${i + 1}` }));
  return [...blanks, ...filled];
});

const monthLabel = computed(() =>
  new Date(current.value.year, current.value.month).toLocaleString("default", {
    month: "long",
    year: "numeric",
  }),
);

function prevMonth() {
  current.value =
    current.value.month === 0
      ? { year: current.value.year - 1, month: 11 }
      : { ...current.value, month: current.value.month - 1 };
}
function nextMonth() {
  current.value =
    current.value.month === 11
      ? { year: current.value.year + 1, month: 0 }
      : { ...current.value, month: current.value.month + 1 };
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"];
const barChartData = computed(() => ({
  labels: MONTHS,
  datasets: [
    {
      label: "Revenue",
      data: [4200, 5800, 3900, 7100, 6400, 8200],
      backgroundColor: "var(--color-primary)",
      borderRadius: 4,
    },
  ],
}));

const barChartOptions = {
  responsive: true,
  plugins: { legend: { display: false } },
  scales: {
    x: { grid: { display: false } },
    y: { grid: { color: "var(--color-border)" } },
  },
};

const lineChartData = computed(() => ({
  labels: MONTHS,
  datasets: [
    {
      label: "Users",
      data: [320, 410, 280, 540, 490, 620],
      borderColor: "var(--color-primary)",
      backgroundColor: "transparent",
      pointBackgroundColor: "var(--color-primary)",
      tension: 0.4,
    },
  ],
}));

const lineChartOptions = {
  responsive: true,
  plugins: { legend: { display: false } },
  scales: {
    x: { grid: { display: false } },
    y: { grid: { color: "var(--color-border)" } },
  },
};
</script>

<template>
