        <h2 class="text-xl font-semibold text-foreground">Chart</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Bar and line charts via <code class="rounded bg-muted px-1 py-0.5 text-xs">vue-chartjs</code> — colours reference CSS custom properties so they honour the active theme.
        </p>
      </div>
      <div class="rounded-lg border border-border bg-muted/50 p-8">
        <div class="flex flex-col gap-8">
          <div>
            <p class="mb-3 text-sm font-medium text-foreground">Monthly Revenue</p>
            <Bar :data="barChartData" :options="barChartOptions" />
          </div>
          <div>
            <p class="mb-3 text-sm font-medium text-foreground">New Users</p>
            <Line :data="lineChartData" :options="lineChartOptions" />
          </div>
        </div>
      </div>
      <CodeBlock :code="CHART_CODE" :collapsible="true" :default-open="false" filename="Chart.vue" language="vue" />
    </section>

    <section class="flex flex-col gap-4" id="data-table">
      <div class="border-l-2 border-primary/40 pl-3">
        <h2 class="text-xl font-semibold text-foreground">DataTable</h2>
        <p class="mt-1 text-sm text-muted-foreground">A sortable data table with status badges — plain HTML table with Tailwind.</p>
      </div>
      <div class="rounded-lg border border-border bg-muted/50 p-8">
        <div class="overflow-x-auto rounded-lg border border-border">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border bg-muted/50">
                <th
                  class="cursor-pointer px-4 py-3 text-left font-medium text-muted-foreground hover:text-foreground"
                  scope="col"
                  @click="sortAsc = !sortAsc"
                >
                  Name {{ sortAsc ? "↑" : "↓" }}
                </th>
                <th class="px-4 py-3 text-left font-medium text-muted-foreground" scope="col">Status</th>
                <th class="px-4 py-3 text-right font-medium text-muted-foreground" scope="col">Revenue</th>
                <th class="px-4 py-3 text-right font-medium text-muted-foreground" scope="col">Change</th>
              </tr>
            </thead>
            <tbody>
              <tr v-for="row in sorted" :key="row.name" class="border-b border-border last:border-0 hover:bg-muted/30">
                <td class="px-4 py-3 font-medium text-foreground">{{ row.name }}</td>
                <td class="px-4 py-3">
                  <span :class="cn('rounded-full px-2 py-0.5 text-xs font-medium', row.status === 'Active' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-muted text-muted-foreground')">
                    {{ row.status }}
                  </span>
                </td>
                <td class="px-4 py-3 text-right text-foreground">{{ row.revenue }}</td>
                <td :class="cn('px-4 py-3 text-right font-medium', row.change.startsWith('+') ? 'text-green-600 dark:text-green-400' : 'text-destructive')">
                  {{ row.change }}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <CodeBlock :code="DATA_TABLE_CODE" :collapsible="true" :default-open="false" filename="DataTable.vue" language="vue" />
    </section>

    <section class="flex flex-col gap-4" id="calendar">
      <div class="border-l-2 border-primary/40 pl-3">
        <h2 class="text-xl font-semibold text-foreground">Calendar</h2>
        <p class="mt-1 text-sm text-muted-foreground">A month-view calendar grid with previous/next navigation — plain grid layout, no external dependency.</p>
      </div>
      <div class="rounded-lg border border-border bg-muted/50 p-8">
        <div class="w-72 rounded-xl border border-border bg-surface p-4">
          <div class="mb-3 flex items-center justify-between">
            <button class="rounded p-1 text-muted-foreground transition hover:bg-accent hover:text-foreground" type="button" @click="prevMonth">◂</button>
            <span class="text-sm font-semibold text-foreground">{{ monthLabel }}</span>
            <button class="rounded p-1 text-muted-foreground transition hover:bg-accent hover:text-foreground" type="button" @click="nextMonth">▸</button>
          </div>
          <div class="grid grid-cols-7 gap-1 text-center text-xs text-muted-foreground">
            <div v-for="d in ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']" :key="d">{{ d }}</div>
            <button
              v-for="{ day, key } in days"
              :key="key"
              :class="cn(
                'rounded py-1 text-sm transition',
                !day && 'invisible',
                day === today.getDate() && current.month === today.getMonth() && current.year === today.getFullYear()
                  ? 'bg-primary font-semibold text-primary-foreground'
